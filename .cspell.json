		"src/legacy/**",
		"resources/contracts/cache/**",
		"resources/contracts/lib/**",
		"resources/contracts/out/**",
		"resources/contracts/images/**"
	],
	"patterns": [
		{ "name": "Bitcoin addresses", "pattern": "/\\bbtc:[0-9a-z]+/g" },
		{ "name": "CIDv1", "pattern": "/\\bbafy\\w+/g" },
		{
			"name": "Chrome extension IDs",
			"pattern": "/(?:chrome\\.google\\.com\\/webstore\\/[^\\s]*\\/[a-z]{32}\\b|\\b[a-z]{32}\\.manifest\\.json)/g"
		},
		{ "name": "Hexadecimal addresses", "pattern": "/\\b0x(?:addr)?[0-9a-f]+\\b/gi" },
		{ "name": "svgicons2svgfont", "pattern": "/svgicons2svgfont/g" }
	],
	"ignoreRegExpList": [
		"Bitcoin addresses",
		"CIDv1",
		"Chrome extension IDs",
		"Hexadecimal addresses",
		"svgicons2svgfont"
	]
}
