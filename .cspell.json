	"flagWords": [],
	"ignorePaths": [
		"**/*.css",
		"**/fonts/**/*.svg",
		"data/software-wallets/manifests/**",
		"data/collection/global.annotations.json",
		"data/entities/domains/entity-domains.json",
		"data/*-wallets/collection/*/*.json",
		"dist/**",
		"node_modules/**",
		"pnpm-lock.yaml",
		"public/**/*.svg",
		"resources/files/**",
		"src/generated/**",
		"src/legacy/**",
		"resources/contracts/cache/**",
		"resources/contracts/lib/**",
		"resources/contracts/out/**",
		"resources/contracts/images/**"
	],
	"patterns": [
		{ "name": "4everland", "pattern": "/\\b4everland\\b/gi" },
		{
			"name": "Audit finding titles",
			"pattern": "/\\b[A-Z]{2,5}-\\d{2}-\\d{3} WP\\d(?:-WP\\d)?: [^\\n]*/g"
		},
		{ "name": "Bitcoin addresses", "pattern": "/\\bbtc:[0-9a-z]+/g" },
		{ "name": "CIDv1", "pattern": "/\\bbafy\\w+/g" },
		{
			"name": "Chrome extension IDs",
			"pattern": "/(?:chrome\\.google\\.com\\/webstore\\/[^\\s]*\\/[a-z]{32}\\b|\\b[a-z]{32}\\.manifest\\.json)/g"
		},
		{
			"name": "Chrome extension literally",
			"pattern": "/\\bChrome extensions?\\b/g"
		},
		{ "name": "Git commit ref pins", "pattern": "/@(?:[0-9a-f]{40}|[0-9a-f]{7})\\b/g" },
		{ "name": "Git short commit hashes", "pattern": "/\\b[0-9a-f]{8}\\b/g" },
		{ "name": "GitHub line anchors", "pattern": "/\\bL\\d+(?:-\\d+)?\\b/g" },
		{ "name": "Hexadecimal addresses", "pattern": "/\\b0x(?:addr)?[0-9a-f]+\\b/gi" },
		{ "name": "Million-dollar and billion-dollar amounts", "pattern": "/\\$[.0-9a]+[BM]/g" },
		{
			"name": "Rabby Walle audit PDF filename",
			"pattern": "/Debank Rabby Walle Audit Report\\.pdf/g"
		},
		{ "name": "Seven Seven Six", "pattern": "/Seven Seven Six/g" },
		{ "name": "svgicons2svgfont", "pattern": "/svgicons2svgfont/g" },
		{ "name": "Version numbers", "pattern": "/\\bv[0-9]+(?:\\.[0-9]+)?(?:\\.[0-9]+)?\\b/g" },
		{ "name": "backdoor", "pattern": "/\\bbackdoor\\b/gi" },
		{ "name": "C.", "pattern": "/\\bC\\./g" },
		{ "name": "N/A", "pattern": "/\\bN\\/A\\b/g" },
		{ "name": "tl;dr", "pattern": "/\\btl;dr\\b/g" },
		{
			"name": "Technical tokens",
			"pattern": "/\\b[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*\\.(?:ai|alarms|app|be|c|dev|eth|example|fyi|global|graphql|im|inc|js|json|limo|lock|md|me|network|one|pdf|png|quest|rs|so|sol|storage|swiss|tech|ts|tsx|xml|xyz|yaml|yml)\\b/g"
		},
		{
			"name": "Mixed-case filenames",
			"pattern": "/\\b(?=[a-z0-9_-]*[A-Z])[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.(?:ai|alarms|app|be|c|dev|eth|example|fyi|global|graphql|im|inc|js|json|limo|lock|md|me|network|one|pdf|png|quest|rs|so|sol|storage|swiss|tech|ts|tsx|xml|xyz|yaml|yml)\\b/g"
		}
	],
	"ignoreRegExpList": [
		"4everland",
		"Audit finding titles",
		"backdoor",
		"Bitcoin addresses",
		"CIDv1",
		"Chrome extension IDs",
		"Chrome extension literally",
		"C.",
		"Git commit ref pins",
		"Git short commit hashes",
		"GitHub line anchors",
		"Hexadecimal addresses",
		"Million-dollar and billion-dollar amounts",
		"Mixed-case filenames",
		"N/A",
		"Rabby Walle audit PDF filename",
		"Seven Seven Six",
		"svgicons2svgfont",
		"Technical tokens",
		"tl;dr",
		"Version numbers"
	]
}
