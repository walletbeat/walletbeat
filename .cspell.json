	"ignorePaths": [
		"**/*.css",
		"**/fonts/**/*.svg",
		"data/software-wallets/manifests/**",
		"data/collection/global.annotations.json",
		"data/entities/domains/entity-domains.json",
		"data/*-wallets/collection/*/*.json",
