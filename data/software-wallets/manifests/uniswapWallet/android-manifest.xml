<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="com.uniswap">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.USE_BIOMETRIC" />
  <uses-permission android:name="android.permission.USE_FINGERPRINT" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

  <!-- Strip READ_MEDIA_IMAGES merged from expo-screen-capture; Play disallows it. Disables screenshot detection on Android 13 only. -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />

  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    tools:replace="android:fullBackupContent"
    android:fullBackupContent="@xml/backup_rules"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:localeConfig="@xml/locales_config"
    android:theme="@style/AppTheme"
    android:taskAffinity=""
    android:excludeFromRecents="true">

    <!-- PROFILING: allow Perfetto/heapprofd to attach to this release build (not debuggable; no perf cost). -->
    <profileable android:shell="true" />

    <meta-data
      android:name="com.onesignal.messaging.default_notification_icon"
      android:resource="@drawable/ic_stat_onesignal_default" />

    <meta-data
      android:name="com.onesignal.NotificationAccentColor.DEFAULT"
      android:value="@string/notification_accent_color" />

    <meta-data
      android:name="com.onesignal.NotificationServiceExtension"
      android:value="com.uniswap.notifications.SilentPushNotificationServiceExtension" />

    <!-- We use FCM for WalletConnect push notifications -->

    <meta-data
      android:name="com.google.firebase.messaging.default_notification_icon"
      android:resource="@drawable/ic_stat_onesignal_default" />

    <meta-data
      android:name="com.google.firebase.messaging.default_notification_color"
      android:value="@string/notification_accent_color" />

    <!-- Fully qualified, not ".MainActivity": the flavor applicationIds (com.uniswap.mobile[.dev|.beta])
         differ from the namespace (com.uniswap), and `expo run:android` resolves the launch activity by
         appending a relative name to the applicationId — yielding a com.uniswap.mobile.MainActivity that
         doesn't exist. A qualified name is passed through as-is. -->
    <activity
      android:name="com.uniswap.MainActivity"
      android:label="@string/app_name"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
      android:launchMode="singleTop"
      android:windowSoftInputMode="adjustResize"
      android:exported="true"
      android:supportsRtl="true"
      android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data android:scheme="uniswap" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data android:scheme="wc" />
      </intent-filter>
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:scheme="https"
          android:host="app.uniswap.org"
          android:pathPrefix="/nfts/asset/" />

        <data
          android:scheme="https"
          android:host="app.uniswap.org"
          android:pathPrefix="/nfts/collection/" />

        <data
          android:scheme="https"
          android:host="app.uniswap.org"
          android:pathPrefix="/tokens" />

        <data
          android:scheme="https"
          android:host="app.uniswap.org"
          android:pathPrefix="/portfolio/" />

        <data
          android:scheme="https"
          android:host="app.uniswap.org"
          android:pathPrefix="/explore/tokens" />

        <data
          android:scheme="https"
          android:host="app.uniswap.org"
          android:pathPrefix="/swap" />

        <data
          android:scheme="https"
          android:host="app.uniswap.org"
          android:pathPrefix="/buy" />
      </intent-filter>
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:scheme="https"
          android:host="uniswap.org"
          android:pathPrefix="/app" />

        <data
          android:scheme="https"
          android:host="uniswap.org"
          android:pathPrefix="/app/wc" />
      </intent-filter>
    </activity>

    <!-- Trampoline for Expo scheme discovery — see ExpoDevClientSchemeActivity.kt.
         Disabled on purpose: `@expo/config-plugins` reads this manifest statically, so the
         declaration alone is enough. Leaving it enabled makes it a second match for
         uniswap://expo-development-client/… alongside MainActivity's host-less `uniswap` filter,
         and Android answers a two-way implicit match with the ResolverActivity chooser. -->
    <activity
      android:name="com.uniswap.ExpoDevClientSchemeActivity"
      android:enabled="false"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:scheme="uniswap"
          android:host="expo-development-client" />
      </intent-filter>
    </activity>
  </application>
</manifest>
