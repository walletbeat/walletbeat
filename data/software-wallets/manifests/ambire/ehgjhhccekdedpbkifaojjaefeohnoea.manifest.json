{
	"update_url": "https://clients2.google.com/service/update2/crx",
	"name": "Ambire Web3 Wallet",
	"short_name": "Ambire",
	"author": "https://www.ambire.com",
	"version": "6.2.5",
	"manifest_version": 3,
	"permissions": [
		"storage",
		"tabs",
		"unlimitedStorage",
		"activeTab",
		"notifications",
		"scripting",
		"alarms",
		"system.display"
	],
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"16": "assets/images/xicon@16.png",
		"48": "assets/images/xicon@48.png",
		"96": "assets/images/xicon@96.png",
		"128": "assets/images/xicon@128.png"
	},
	"action": {
		"default_title": "Ambire",
		"default_popup": "index.html"
	},
	"host_permissions": ["http://*/*", "https://*/*", "file://*/*", "wss://*/*"],
	"externally_connectable": {
		"ids": ["*"]
	},
	"description": "Fast & secure Web3 wallet to supercharge your account on Ethereum and EVM networks.",
	"content_security_policy": {
		"extension_pages": "frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
	},
	"key": ""
}
