{
	"update_url": "https://clients2.google.com/service/update2/crx",
	"manifest_version": 3,
	"name": "__MSG_appName__",
	"description": "__MSG_appDesc__",
	"version": "26.39.3",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"default_locale": "en",
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"action": {
		"default_title": "Trust Wallet",
		"default_icon": "icons/light/32px.png",
		"default_popup": "popup.html"
	},
	"host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
	"permissions": [
		"alarms",
		"tabs",
		"storage",
		"clipboardWrite",
		"notifications",
		"scripting",
		"sidePanel",
		"gcm"
	],
	"minimum_chrome_version": "114",
	"background": {
		"service_worker": "background.js"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"content_scripts": [
		{
			"matches": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
			"all_frames": true,
			"exclude_matches": [
				"*://*.amazon-adsystem.com/*",
				"*://*.arkoselabs.com/*",
				"*://*.calendar.google.com/*",
				"*://*.captcha-delivery.com/*",
				"*://*.challenges.cloudflare.com/*",
				"*://*.docs.google.com/*",
				"*://*.doubleclick.net/*",
				"*://*.drive.google.com/*",
				"*://*.facebook.com/*",
				"*://*.fb.com/*",
				"*://*.funcaptcha.com/*",
				"*://*.googlesyndication.com/*",
				"*://*.hcaptcha.com/*",
				"*://*.instagram.com/*",
				"*://*.keep.google.com/*",
				"*://*.linkedin.com/*",
				"*://*.magic.link/*",
				"*://*.mail.google.com/*",
				"*://*.meet.google.com/*",
				"*://*.messenger.com/*",
				"*://*.meta.com/*",
				"*://*.recaptcha.net/recaptcha/*",
				"*://*.snapchat.com/*",
				"*://*.threads.net/*",
				"*://*.tiktok.com/*",
				"*://*.twitter.com/*",
				"*://*.whatsapp.com/*",
				"*://*.workplace.com/*",
				"*://*.x.com/*",
				"*://www.google.com/recaptcha/*"
			],
			"run_at": "document_start",
			"js": ["content-scripts/content.js"]
		}
	]
}
