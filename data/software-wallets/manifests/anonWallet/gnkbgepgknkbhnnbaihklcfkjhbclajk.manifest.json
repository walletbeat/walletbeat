{
	"update_url": "https://clients2.google.com/service/update2/crx",
	"manifest_version": 3,
	"name": "__MSG_extensionName__",
	"short_name": "Anon Wallet",
	"version": "0.10.2",
	"description": "__MSG_extensionDescription__",
	"author": "Anon Inc.",
	"homepage_url": "https://anon.inc",
	"permissions": [
		"activeTab",
		"storage",
		"unlimitedStorage",
		"notifications",
		"tabs",
		"alarms",
		"sidePanel"
	],
	"host_permissions": ["<all_urls>"],
	"action": {
		"default_popup": "popup.html",
		"default_title": "__MSG_extensionActionTitle__",
		"default_icon": {
			"16": "assets/generated/icon16.png",
			"32": "assets/generated/icon32.png",
			"48": "assets/generated/icon48.png",
			"128": "assets/generated/icon128.png"
		}
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["providerContent.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"icons": {
		"16": "assets/generated/icon16.png",
		"32": "assets/generated/icon32.png",
		"48": "assets/generated/icon48.png",
		"128": "assets/generated/icon128.png"
	},
	"web_accessible_resources": [
		{
			"resources": ["pageProvider.js"],
			"matches": ["<all_urls>"]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
	},
	"minimum_chrome_version": "116",
	"default_locale": "en",
	"options_page": "popup.html",
	"commands": {
		"toggle_anon": {
			"suggested_key": {
				"default": "Ctrl+Shift+A",
				"mac": "Command+Shift+A"
			},
			"description": "__MSG_extensionCommandToggle__"
		}
	},
	"optional_permissions": ["nativeMessaging"]
}
