	"segments": [
		{
			"lines": [
				"import Foundation",
				"",
				"/// **YOUR ACCOUNT (docs/safe-wallet-spec.md, prd §1421, §1422) — the",
				"/// arithmetic.** A Safe 1.4.1 whose one owner is Safe's own shared passkey",
				"/// signer, set up with this phone's Secure Enclave key, run through Safe's",
				"/// 4337 module. Every contract is Safe's, at the addresses in Safe's own",
				"/// deployment records — identical on Base, Base Sepolia, Ethereum and",
				"/// Sepolia (measured 2026-10-19) — so the address is one address on every",
				"/// chain, and nothing of ours is on chain (prd §1380).",
				"///",
				"/// **The address needs no network.** SafeProxyFactory 1.4.1's CREATE2 is",
				"/// `keccak(0xff ‖ factory ‖ keccak(keccak(initializer) ‖ saltNonce) ‖",
				"/// keccak(proxyCreationCode ‖ singleton))`, and the creation code is fixed:",
				"/// read from the factory on all three networks, 486 bytes, identical, and",
				"/// pinned here. `scripts/your-account-selftest.sh` holds the address to the",
				"/// value the factory's own simulated create returned for the same key. So an",
				"/// account can receive before it exists, with no request made: the first",
				"/// send creates it (`tools/safe-account-spike`, measured on an iPhone).",
				"///",
				"/// Foundation-only and pure; the key lives in `YourAccountKey`.",
				"enum YourAccount {",
				"    static let safeL2 = \"0x29fcB43b46531BcA003ddC8FCB67FFE91900C762\"",
				"    static let proxyFactory = \"0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67\"",
				"    static let multiSend = \"0x38869bf66a61cF6bDB996A6aE40D5853Fd43B526\"",
				"    static let module4337 = \"0x75cf11467937ce3F2f357CE24ffc3DBF8fD5c226\"",
				"    static let moduleSetup = \"0x2dd68b007B46fBe91B9A7c3EDa5A7a1063cB5b47\"",
				"    static let sharedSigner = \"0x94a4F6affBd8975951142c3999aEAB7ecee555c2\"",
				"    static let entryPoint = \"0x0000000071727De22E5E9d8BAf0edAc6f37da032\"",
				"",
				"    /// `SafeProxyFactory.proxyCreationCode()`, read 2026-10-19 on Base, Base",
				"    /// Sepolia and Ethereum: the same 486 bytes on each.",
				"    static let proxyCreationCode: [UInt8] = SafeABI.hexBytes(",
				"        \"\"",
				"    )!",
				"",
				"    // MARK: - ABI",
				"",
				"    static func sel(_ signature: String) -> [UInt8] { SafeABI.hexBytes(SafeCalldata.selector(signature))! }",
				"    static func w(_ address: String) -> [UInt8] { SafeABI.word(address: address)! }",
				"    static func w(_ n: Int) -> [UInt8] { SafeABI.word(uint: n)! }",
				"    static func padded(_ bytes: [UInt8]) -> [UInt8] { bytes + [UInt8](repeating: 0, count: (32 - bytes.count % 32) % 32) }",
				"    static func dynamic(_ bytes: [UInt8]) -> [UInt8] { w(bytes.count) + padded(bytes) }",
				"    static func addressBytes(_ address: String) -> [UInt8] { Array(w(address).suffix(20)) }",
				"",
				"    /// `configure((uint256 x, uint256 y, uint176 verifiers))`, delegate-called",
				"    /// by the Safe: the shared signer keeps this key in the Safe's storage.",
				"    static func configure(x: [UInt8], y: [UInt8]) -> [UInt8] {",
				"        sel(\"configure((uint256,uint256,uint176))\") + x + y + SafeWebAuthn.verifiersWord!",
				"    }",
				"",
				"    struct Call { let operation: UInt8; let to: String; let value: [UInt8]; let data: [UInt8] }",
				"",
				"    /// `multiSend(bytes)` over MultiSend 1.4.1's packed transactions.",
				"    static func multiSend(_ calls: [Call]) -> [UInt8] {",
				"        var packed: [UInt8] = []",
				"        for c in calls { packed += [c.operation] + addressBytes(c.to) + c.value + w(c.data.count) + c.data }",
				"        return sel(\"multiSend(bytes)\") + w(32) + dynamic(packed)",
				"    }",
				"",
				"    /// `Safe.setup`: the shared signer the one owner, threshold 1, the 4337",
				"    /// module as module and fallback handler, the key configured — both",
				"    /// set-up steps batched through MultiSend as delegate calls.",
				"    static func initializer(x: [UInt8], y: [UInt8]) -> [UInt8] {",
				"        let enable = sel(\"enableModules(address[])\") + w(32) + w(1) + w(module4337)",
				"        let setupData = multiSend([",
				"            Call(operation: 1, to: moduleSetup, value: w(0), data: enable),",
				"            Call(operation: 1, to: sharedSigner, value: w(0), data: configure(x: x, y: y)),",
				"        ])",
				"        let owners = w(1) + w(sharedSigner)",
				"        let ownersOffset = 8 * 32",
				"        let dataOffset = ownersOffset + owners.count",
				"        return sel(\"setup(address[],uint256,address,bytes,address,address,uint256,address)\")",
				"            + w(ownersOffset) + w(1) + w(multiSend) + w(dataOffset)",
				"            + w(module4337) + w(SafeTransaction.zeroAddress) + w(0) + w(SafeTransaction.zeroAddress)",
				"            + owners + dynamic(setupData)",
				"    }",
				"",
				"    /// The account's address on every chain, for the key it was created with.",
				"    static func address(x: [UInt8], y: [UInt8], salt: Int = 0) -> String? {",
				"        guard x.count == 32, y.count == 32 else { return nil }"
			],
			"startLine": 1
		}
	]
}
