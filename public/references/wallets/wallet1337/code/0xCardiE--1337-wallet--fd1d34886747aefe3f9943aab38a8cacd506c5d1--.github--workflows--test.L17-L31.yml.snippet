				"  e2e:",
				"    runs-on: ubuntu-latest",
				"    steps:",
				"      - uses: actions/checkout@v4",
				"      - uses: actions/setup-node@v4",
				"        with:",
				"          node-version: '22'",
				"          cache: npm",
				"      - name: Install",
				"        run: npm ci",
				"      - name: Install Pillow",
				"        run: sudo apt-get update && sudo apt-get install -y python3-pil",
				"      - name: Production build",
				"        run: npm run icons && npm run build"
