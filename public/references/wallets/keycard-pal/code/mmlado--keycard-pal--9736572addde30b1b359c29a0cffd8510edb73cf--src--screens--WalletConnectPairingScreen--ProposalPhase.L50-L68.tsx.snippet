				"        </Text>",
				"      </View>",
				"    );",
				"  }",
				"  if (validation === 'INVALID') {",
				"    return (",
				"      <View style={styles.verifyInvalid}>",
				"        <Text style={styles.verifyInvalidText}>",
				"          ⚠ Domain could not be verified. Proceed with caution.",
				"        </Text>",
				"      </View>",
				"    );",
				"  }",
				"  if (validation === 'VALID') {",
				"    return (",
				"      <View style={styles.verifyValid}>"
			],
			"startLine": 45
		}
	]
