{
	"highlightFirstLine": 7,
	"highlightLastLine": 7,
	"segments": [
		{
			"lines": [
				"enableConstraintsChecks: true",
				"",
				"enableGlobalCache: true",
				"",
				"enableScripts: false",
				"",
				"nodeLinker: node-modules",
				"",
				"# The devcontainer (.devcontainer/) bind-mounts node_modules from the host,"
			],
			"startLine": 3
		}
	]
}
