{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"description": "Rated wallet JSON export: top-level metadata, an overall block (aggregated attribute groups), and a perVariant object with one key per variant (MOBILE, DESKTOP, BROWSER, EMBEDDED, HARDWARE) present in variants, each with the same attribute-group structure as overall.",
	"required": [
		"walletId",
		"types",
		"variants",
		"overall",
		"perVariant",
		"displayName",
		"lastUpdated",
		"stage",
		"stageBreakdown"
	],
	"properties": {
		"$schema": {
			"type": "string",
			"description": "URL of the JSON Schema for this document."
		},
		"walletId": {
			"type": "string",
			"minLength": 1,
			"description": "Unique identifier for the wallet."
		},
		"types": {
			"type": "array",
			"minItems": 1,
			"description": "Wallet types (SOFTWARE, HARDWARE, EMBEDDED) this wallet belongs to.",
			"items": {
				"type": "string",
				"enum": ["SOFTWARE", "HARDWARE", "EMBEDDED"]
			}
		},
		"variants": {
			"type": "array",
			"minItems": 1,
			"description": "List of variants (MOBILE, DESKTOP, BROWSER, EMBEDDED, HARDWARE) this wallet has. Each variant in this list has a corresponding key in perVariant with the same attribute-group structure as overall.",
			"items": {
				"type": "string",
				"enum": ["MOBILE", "DESKTOP", "BROWSER", "EMBEDDED", "HARDWARE"]
			}
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"description": "Human-readable wallet name."
		},
		"lastUpdated": {
			"type": "string",
			"description": "Date the wallet data was last updated (YYYY-MM-DD)."
		},
		"stage": {
			"oneOf": [{ "type": "null" }, { "type": "string" }],
			"description": "Walletbeat stage label, or null if not applicable."
		},
		"stageBreakdown": {
			"oneOf": [
				{ "type": "null" },
				{
					"type": "array",
					"items": { "$ref": "#/$defs/stageBreakdownItem" },
					"description": "Per-stage criteria passed/total and status for the primary ladder; null when stage is not applicable."
				}
			]
		},
		"website": {
			"type": "string",
			"description": "Primary website URL for the wallet, when known."
		},
		"repository": {
			"type": "string",
			"description": "Primary source code repository URL, when known."
		},
		"overall": {
			"type": "object",
			"description": "Aggregated evaluation across all variants. Keys are attribute group ids (e.g. security, privacy); values are objects keyed by attribute id, each with attribute metadata and evaluation block.",
			"additionalProperties": {
				"$ref": "#/$defs/attributeGroupExport"
			}
		},
		"perVariant": {
			"type": "object",
			"minProperties": 1,
			"description": "Per-variant data. Keys are variant names (MOBILE, DESKTOP, BROWSER, EMBEDDED, HARDWARE); only variants listed in the variants array appear. Each value has attributes (evaluation blocks, same structure as overall) and features (raw resolved feature data for that variant).",
			"additionalProperties": {
				"$ref": "#/$defs/perVariantBlock"
			},
			"propertyNames": {
				"enum": ["MOBILE", "DESKTOP", "BROWSER", "EMBEDDED", "HARDWARE"]
			}
		}
	},
	"additionalProperties": false,
	"$defs": {
		"perVariantBlock": {
			"type": "object",
			"additionalProperties": false,
			"required": ["attributes", "features"],
			"description": "Per-variant block: attribute evaluations (same structure as overall) and raw resolved feature data. Full schema for features is TBD; TODO: generate from TypeScript type definitions (see #552).",
			"properties": {
				"attributes": {
					"$ref": "#/$defs/attributeGroupsExport"
				},
				"features": {
					"type": "object",
					"description": "Resolved feature tree for this variant. Structure matches resolved feature data; full schema TBD."
				}
			}
		},
		"stageBreakdownItem": {
			"type": "object",
			"additionalProperties": false,
			"required": ["stageId", "label", "passedCount", "totalCount", "status", "criteriaGroups"],
			"description": "One stage in the ladder: id, label, criteria counts, derived status, and per-group/criterion details.",
			"properties": {
				"stageId": { "type": "string", "minLength": 1 },
				"label": { "type": "string", "minLength": 1 },
				"passedCount": { "type": "integer", "minimum": 0 },
				"totalCount": { "type": "integer", "minimum": 0 },
				"status": {
					"type": "string",
					"enum": ["PASS", "PARTIAL", "FAIL", "UNRATED"]
				},
				"criteriaGroups": {
					"type": "array",
					"items": { "$ref": "#/$defs/stageCriteriaGroupBreakdownItem" },
					"description": "Criteria groups, each with a description and per-criterion details."
				}
			}
		},
		"stageCriteriaGroupBreakdownItem": {
			"type": "object",
			"additionalProperties": false,
			"required": ["description", "criteria"],
			"description": "One criteria group within a stage: a description plus a list of criteria.",
			"properties": {
				"description": { "type": "string" },
				"criteria": {
					"type": "array",
					"items": { "$ref": "#/$defs/stageCriterionBreakdownItem" }
				}
			}
		},
		"stageCriterionBreakdownItem": {
			"type": "object",
			"additionalProperties": false,
			"required": ["criterionId", "attributeId", "displayName", "description", "rating"],
			"description": "One criterion within a stage: display name, description, and rating.",
			"properties": {
				"criterionId": { "type": "string", "minLength": 1 },
				"attributeId": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
				"displayName": {
					"type": "string",
					"minLength": 1,
					"description": "Human-readable name for this criterion."
				},
				"description": { "type": "string" },
				"rating": {
					"type": "string",
					"enum": ["PASS", "FAIL", "EXEMPT", "UNRATED"]
				}
			}
		},
		"attributeGroupsExport": {
			"type": "object",
			"description": "Map of attribute group id (e.g. security, privacy) to group export (attribute id to attribute + evaluation block). Used for overall and for each variant block.",
			"additionalProperties": {
				"$ref": "#/$defs/attributeGroupExport"
			}
		},
		"attributeGroupExport": {
			"type": "object",
			"description": "One attribute group: map of attribute id to attribute export block (attribute metadata + evaluation).",
			"additionalProperties": {
				"$ref": "#/$defs/attributeExportBlock"
			}
		},
		"attributeExportBlock": {
			"type": "object",
			"additionalProperties": false,
			"required": ["attribute", "evaluation"],
			"description": "Single attribute export: attribute metadata (display name, question, methodology) plus wallet-specific evaluation (rating, shortExplanation, details, optional impact, howToImprove, references).",
			"properties": {
				"attribute": {
					"$ref": "#/$defs/attributeBlock"
				},
				"evaluation": {
					"$ref": "#/$defs/ratingBlock"
				}
			}
		},
		"attributeBlock": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"attributeDisplayName",
				"attributeId",
				"shortQuestion",
				"whyItMatters",
				"howIsEvaluated"
			],
			"description": "Attribute-level metadata (same for every wallet).",
			"properties": {
				"attributeDisplayName": {
					"type": "string",
					"minLength": 1
				},
				"attributeId": {
					"type": "string",
					"minLength": 1
				},
				"shortQuestion": {
					"type": "string",
					"description": "Short question describing what the attribute evaluates (e.g. \"Can you send and receive tokens without revealing your transaction history to others?\")"
				},
				"whyItMatters": {
					"type": "string",
					"description": "Body of the \"Why does this matter?\" / \"Why should I care?\" section"
				},
				"howIsEvaluated": {
					"type": "object",
					"additionalProperties": false,
					"required": ["heading", "methodology"],
					"description": "Section heading and body for \"How is this attribute evaluated?\"",
					"properties": {
						"heading": {
							"type": "string",
							"minLength": 1
						},
						"methodology": {
							"type": "string"
						}
					}
				}
			}
		},
		"ratingBlock": {
			"type": "object",
			"additionalProperties": false,
			"required": ["rating", "shortExplanation", "details"],
			"description": "Wallet-specific evaluation result for one attribute (rating, explanation, details, optional impact, howToImprove, references).",
			"properties": {
				"rating": {
					"type": "string",
					"enum": ["PASS", "FAIL", "PARTIAL", "UNRATED", "EXEMPT"],
					"description": "Attribute rating for this wallet. PASS: wallet meets the attribute's criteria. FAIL: wallet does not meet the criteria. PARTIAL: wallet partially meets the criteria. UNRATED: insufficient feature data to evaluate. EXEMPT: attribute is not applicable to this wallet (e.g. by type or profile)."
				},
				"shortExplanation": {
					"type": "string",
					"description": "Brief explanation of why this rating was assigned."
				},
				"details": {
					"type": "string",
					"description": "Longer explanation or summary of the evaluation; may be \"See full details on the wallet page.\" when details are not easily expressed in textual format."
				},
				"structuredDetails": {
					"$ref": "#/$defs/structuredDetails",
					"description": "Optional format-neutral detail model for attributes with structured evaluation content."
				},
				"impact": {
					"type": "string"
				},
				"howToImprove": {
					"type": "string"
				},
				"references": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/reference"
					}
				}
			}
		},
		"structuredDetails": {
			"oneOf": [
				{
					"$ref": "#/$defs/accountRecoveryDetails"
				},
				{
					"$ref": "#/$defs/accountUnruggabilityDetails"
				},
				{
					"$ref": "#/$defs/addressCorrelationDetails"
				},
				{
					"$ref": "#/$defs/chainVerificationDetails"
				},
				{
					"$ref": "#/$defs/fundingDetails"
				},
				{
					"$ref": "#/$defs/privateTransfersDetails"
				},
				{
					"$ref": "#/$defs/scamPreventionDetails"
				},
				{
					"$ref": "#/$defs/securityAuditsDetails"
				},
				{
					"$ref": "#/$defs/transactionInclusionDetails"
				}
			]
		},
		"guardian": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "description"],
			"properties": {
				"type": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"entityId": {
					"type": "string"
				}
			}
		},
		"entityRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["entityId", "entityName"],
			"properties": {
				"entityId": {
					"type": "string"
				},
				"entityName": {
					"type": "string"
				}
			}
		},
		"guardianPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["description", "facts"],
			"properties": {
				"description": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"facts": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": [
								"kind",
								"requiredGuardians",
								"optionalGuardians",
								"optionalGuardiansMinimumConfigurable",
								"optionalGuardiansMinimumNeededForRecovery",
								"secretReconstitution"
							],
							"properties": {
								"kind": {
									"const": "secretSplit"
								},
								"requiredGuardians": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/guardian"
									}
								},
								"optionalGuardians": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/guardian"
									}
								},
								"optionalGuardiansMinimumConfigurable": {
									"type": "number"
								},
								"optionalGuardiansMinimumNeededForRecovery": {
									"type": "number"
								},
								"secretReconstitution": {
									"oneOf": [
										{
											"const": "CLIENT_SIDE"
										},
										{
											"$ref": "#/$defs/entityRef"
										}
									]
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": [
								"kind",
								"configuredGuardians",
								"requiredGuardians",
								"timelockWarningSentByAllOf",
								"minimumSignaturesWithTimelock",
								"minimumSignaturesBypassTimelock"
							],
							"properties": {
								"kind": {
									"const": "kOfNWithTimelock"
								},
								"configuredGuardians": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/guardian"
									}
								},
								"requiredGuardians": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/guardian"
									}
								},
								"timelockWarningSentByAllOf": {
									"type": "array",
									"items": {
										"$ref": "#/$defs/entityRef"
									}
								},
								"minimumSignaturesWithTimelock": {
									"type": "number"
								},
								"minimumSignaturesBypassTimelock": {
									"type": "number"
								}
							}
						}
					]
				}
			}
		},
		"guardianScenario": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "scenario"],
			"properties": {
				"id": {
					"type": "string"
				},
				"scenario": {
					"type": "string"
				},
				"consequence": {
					"type": "string"
				}
			}
		},
		"accountRecoveryDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "recoverableScenarios", "unrecoverableScenarios"],
			"properties": {
				"type": {
					"const": "accountRecovery"
				},
				"guardianPolicy": {
					"$ref": "#/$defs/guardianPolicy"
				},
				"recoverableScenarios": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/guardianScenario"
					}
				},
				"unrecoverableScenarios": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/guardianScenario"
					}
				},
				"drills": {
					"type": "object",
					"additionalProperties": false,
					"required": ["configured", "missing"],
					"properties": {
						"configured": {
							"type": "array",
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["type", "name", "reminderEveryNDays"],
								"properties": {
									"type": {
										"type": "string",
										"enum": ["PRIVATE_KEY_QUIZ", "SEED_PHRASE_QUIZ", "GUARDIAN_ACCOUNT_CHECK"]
									},
									"name": {
										"type": "string"
									},
									"reminderEveryNDays": {
										"type": "number"
									},
									"references": {
										"type": "array",
										"items": {
											"$ref": "#/$defs/reference"
										}
									}
								}
							}
						},
						"missing": {
							"type": "array",
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["type", "name"],
								"properties": {
									"type": {
										"type": "string",
										"enum": ["PRIVATE_KEY_QUIZ", "SEED_PHRASE_QUIZ", "GUARDIAN_ACCOUNT_CHECK"]
									},
									"name": {
										"type": "string"
									}
								}
							}
						}
					}
				}
			}
		},
		"accountUnruggabilityDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "safeScenarios", "takeoverScenarios"],
			"properties": {
				"type": {
					"const": "accountUnruggability"
				},
				"guardianPolicy": {
					"$ref": "#/$defs/guardianPolicy"
				},
				"safeScenarios": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/guardianScenario"
					}
				},
				"takeoverScenarios": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/guardianScenario"
					}
				}
			}
		},
		"addressCorrelationDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "leaks"],
			"properties": {
				"type": {
					"const": "addressCorrelation"
				},
				"leaks": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["source", "correlatedInfo"],
						"properties": {
							"source": {
								"oneOf": [
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["kind"],
										"properties": {
											"kind": {
												"const": "onchain"
											}
										}
									},
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["kind", "entityId", "entityName"],
										"properties": {
											"kind": {
												"const": "entity"
											},
											"entityId": {
												"type": "string"
											},
											"entityName": {
												"type": "string"
											}
										}
									}
								]
							},
							"correlatedInfo": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": ["info", "name"],
									"properties": {
										"info": {
											"type": "string",
											"enum": [
												"IP_ADDRESS",
												"TRACKING_IDENTIFIER",
												"PSEUDONYM",
												"LEGAL_NAME",
												"EMAIL",
												"PHONE",
												"BROWSING_HISTORY_URLS",
												"CONTACTS",
												"PHYSICAL_ADDRESS",
												"USER_ACTIONS",
												"ACCOUNT_ADDRESS",
												"BALANCE",
												"ASSETS",
												"MEMPOOL_TRANSACTIONS",
												"WALLET_CONNECTED_DOMAINS"
											]
										},
										"name": {
											"type": "string"
										}
									}
								}
							},
							"references": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/reference"
								}
							}
						}
					}
				}
			}
		},
		"chainVerificationDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "lightClients"],
			"properties": {
				"type": {
					"const": "chainVerification"
				},
				"lightClients": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "name", "url"],
						"properties": {
							"id": {
								"type": "string",
								"enum": ["helios", "heliosMobi"]
							},
							"name": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"fundingDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "strategies", "revenueBreakdownIsPublic"],
			"properties": {
				"type": {
					"const": "funding"
				},
				"strategies": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["strategy", "name", "userAligned"],
						"properties": {
							"strategy": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"userAligned": {
								"type": "boolean"
							}
						}
					}
				},
				"revenueBreakdownIsPublic": {
					"type": "boolean"
				}
			}
		},
		"inlineText": {
			"type": "object",
			"additionalProperties": false,
			"required": ["text"],
			"properties": {
				"text": {
					"type": "string"
				},
				"links": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["text", "url"],
						"properties": {
							"text": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"privateTransfersDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "technologies"],
			"properties": {
				"type": {
					"const": "privateTransfers"
				},
				"technologies": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["technology", "name", "sending", "receiving", "spending"],
						"properties": {
							"technology": {
								"type": "string",
								"enum": ["stealthAddresses", "tornadoCashNova", "privacyPools", "railgun"]
							},
							"name": {
								"type": "string"
							},
							"sending": {
								"$ref": "#/$defs/inlineText"
							},
							"receiving": {
								"$ref": "#/$defs/inlineText"
							},
							"spending": {
								"$ref": "#/$defs/inlineText"
							},
							"notes": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/inlineText"
								}
							}
						}
					}
				},
				"defaultModeNote": {
					"$ref": "#/$defs/inlineText"
				}
			}
		},
		"scamPreventionDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "warnings"],
			"properties": {
				"type": {
					"const": "scamPrevention"
				},
				"warnings": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["kind", "description"],
						"properties": {
							"kind": {
								"type": "string",
								"enum": ["sendTransaction", "contractTransaction", "scamUrl", "unlimitedApproval"]
							},
							"description": {
								"type": "string"
							},
							"items": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"conclusion": {
								"type": "string"
							},
							"references": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/reference"
								}
							}
						}
					}
				}
			}
		},
		"securityAuditsDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "audits"],
			"properties": {
				"type": {
					"const": "securityAudits"
				},
				"audits": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["auditor", "auditDate", "variants", "findings"],
						"properties": {
							"auditor": {
								"type": "object",
								"additionalProperties": false,
								"required": ["id", "name"],
								"properties": {
									"id": {
										"type": "string"
									},
									"name": {
										"type": "string"
									}
								}
							},
							"auditDate": {
								"type": "string",
								"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
							},
							"variants": {
								"oneOf": [
									{
										"const": "ALL_VARIANTS"
									},
									{
										"type": "array",
										"items": {
											"type": "string",
											"enum": ["MOBILE", "DESKTOP", "BROWSER", "EMBEDDED", "HARDWARE"]
										}
									}
								]
							},
							"findings": {
								"type": "string",
								"enum": ["NONE_FOUND", "ALL_FIXED", "FLAWS"]
							},
							"flaws": {
								"type": "array",
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": ["name", "severity", "status"],
									"properties": {
										"name": {
											"type": "string"
										},
										"severity": {
											"type": "string",
											"enum": ["CRITICAL", "HIGH", "MEDIUM"]
										},
										"status": {
											"type": "string",
											"enum": ["FIXED", "NOT_FIXED"]
										}
									}
								}
							},
							"references": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/reference"
								}
							}
						}
					}
				},
				"bugBounty": {
					"type": "object",
					"additionalProperties": false,
					"required": ["availability", "coverage", "upgradePathAvailable"],
					"properties": {
						"availability": {
							"type": "string",
							"enum": ["ACTIVE", "INACTIVE", "NONE"]
						},
						"coverage": {
							"oneOf": [
								{
									"const": "FULL_SCOPE"
								},
								{
									"type": "array",
									"items": {
										"type": "string",
										"enum": ["APP_ONLY", "FIRMWARE_ONLY", "HARDWARE_ONLY"]
									}
								}
							]
						},
						"platform": {
							"type": "string"
						},
						"rewards": {
							"type": "object",
							"additionalProperties": false,
							"required": ["currency"],
							"properties": {
								"minimum": {
									"type": "number"
								},
								"maximum": {
									"type": "number"
								},
								"currency": {
									"type": "string"
								}
							}
						},
						"legalProtection": {
							"type": "string",
							"enum": ["SAFE_HARBOR", "LEGAL_ASSURANCE"]
						},
						"disclosureDays": {
							"type": "number"
						},
						"upgradePathAvailable": {
							"type": "boolean"
						},
						"references": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/reference"
							}
						}
					}
				}
			}
		},
		"transactionInclusionDetails": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "l1Broadcast", "l2s"],
			"properties": {
				"type": {
					"const": "transactionInclusion"
				},
				"l1Broadcast": {
					"type": "string",
					"enum": ["NO", "SELF_GOSSIP", "OWN_NODE"]
				},
				"l2s": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["l2", "name", "forceInclusion"],
						"properties": {
							"l2": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"forceInclusion": {
								"type": "string",
								"enum": ["ARBITRARY_TRANSACTIONS", "WITHDRAWALS_ONLY", "NONE"]
							}
						}
					}
				},
				"l1References": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/reference"
					}
				},
				"l2References": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/reference"
					}
				}
			}
		},
		"reference": {
			"type": "object",
			"additionalProperties": false,
			"required": ["urls"],
			"description": "Optional reference with explanation and one or more URLs.",
			"properties": {
				"explanation": {
					"type": "string"
				},
				"urls": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/referenceUrl"
					}
				}
			}
		},
		"referenceUrl": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "url"],
			"description": "Single URL with optional label.",
			"properties": {
				"label": {
					"type": "string"
				},
				"url": {
					"type": "string"
				}
			}
		}
	}
}
