{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": [
		"dist",
		"resources/contracts",
		"src/tools/wallet-data-collection/agent/backup-tree.bak"
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/data/*": ["./data/*"],
			"@/tests/*": ["./tests/*"],
			"@/*": ["src/*"]
		},
		"lib": ["esnext"],
		"forceConsistentCasingInFileNames": false
	}
}
