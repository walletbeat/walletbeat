{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "resources/contracts", "src/tools/wallet-data-collection/agent"],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/data/*": ["./data/*"],
			"@/tests/*": ["./tests/*"],
			"@/*": ["src/*"],
			"pi-ask-user/index.ts": ["./src/tools/wallet-data-collection/agent/pi-ask-user.d.ts"]
		},
		"lib": ["esnext"],
		"forceConsistentCasingInFileNames": false
	}
}
