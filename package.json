{
	"name": "walletbeat",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.19.0",
	"scripts": {
		"astro": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro",
		"build": "deploy/build.sh",
		"check:all": "pnpm run \"/^check:(astro|vitest|lint|syntax|spelling:quiet|misc|build:post:quiet|signed-commit:quiet)$/\"",
		"check:ci": "cross-env WALLETBEAT_ENV=CI pnpm run \"/^check:(all|ci:.*)$/\"",
		"check:quick": "pnpm run \"/^check:(lint:quick|syntax|spelling:quiet|misc)$/\"",
		"check:astro": "pnpm run astro check --minimumSeverity=hint --minimumFailingSeverity=hint",
		"check:build:post": "tests/postbuild.sh",
		"check:build:post:quiet": "cross-env QUIET=true pnpm run check:build:post",
		"check:ci:bundle:size-delta": "bash tests/ci/bundle-size-delta.test.sh",
		"check:ci:build-determinism": "bash tests/ci/build-determinism.test.sh",
		"check:lint": "pnpm run astro sync && eslint --cache src data tests",
		"check:lint:quick": "cross-env WALLETBEAT_PRECOMMIT_FAST=true pnpm run check:lint --report-unused-disable-directives-severity=off",
		"check:misc": "pnpm run \"/^check:misc:.+/\"",
		"check:misc:must-be-static": "bash deploy/misc-tests/must_be_static.sh",
		"check:misc:no-console-logging": "bash deploy/misc-tests/no_console_logging.sh",
		"check:misc:no-fixme": "bash deploy/misc-tests/no_fixme.sh",
		"check:misc:no-undefined-wallet-features": "bash deploy/misc-tests/no_undefined_in_wallet_features.sh",
		"check:spelling": "cspell lint .",
		"check:spelling:reorder": "tests/cspell/reorder-cspell.sh",
		"check:spelling:quiet": "cspell lint --quiet --no-progress .",
		"check:syntax": "prettier --check .",
		"check:eip-status": "tsx src/tools/eip-status-checker/eip-status-checker.ts",
		"check:treasury:markdown": "tsx src/tools/treasury-markdown-updater/treasury-markdown-updater.ts",
		"check:features:markdown": "tsx src/tools/features-markdown-generator/features-markdown-generator.ts",
		"check:signed-commit": "bash tests/signed-commit.test.sh",
		"check:signed-commit:quiet": "bash tests/signed-commit.test.sh --quiet",
		"check:vitest": "vitest --typecheck --cache --run",
		"generate:css-attributes": "pnpm run \"/^generate:css-attributes:.+/\"",
		"generate:css-attributes:typescript": "tsx src/styles/generate/css-attributes-typescript.ts",
		"generate:css-attributes:vscode": "tsx src/styles/generate/css-attributes-vscode.ts",
		"generate:wbicons": "tsx src/tools/icon-font-generator/icon-font-generator.ts --font-name wbicons --font-type-name WBIcon --svg-icons-dir resources/files/wbicons --font-output-dir src/assets/fonts/wbicons --css-output-dir src/styles",
		"l1-lying-rpc-proxy": "tsx src/tools/l1-lying-rpc-proxy/index.ts",
		"dev": "cross-env WALLETBEAT_DEV=true pnpm run astro dev",
		"dev:background": "deploy/dev/background-dev.sh",
		"dev:background:stop": "deploy/dev/background-dev.sh --stop",
		"dev:background:restart": "deploy/dev/background-dev.sh --restart",
		"lint": "pnpm run check:syntax --write && pnpm run check:lint --fix && pnpm run check:spelling:reorder",
		"preview": "pnpm run astro preview",
		"fix": "pnpm run lint && pnpm run check:treasury:markdown && pnpm run wallet-data-collection lint-fix && pnpm run check:features:markdown && pnpm run generate:css-attributes && pnpm run generate:wbicons",
		"helios": "deploy/helios/helios.sh",
		"helios:wrap": "deploy/helios/helios-wrap.sh",
		"collect:manifests": "tsx src/tools/manifest-collector/manifest-collector.ts",
		"deploy:4everland-pin-tool": "tsx src/4everland-pin-tool/4everland-pin-tool.ts",
		"wallet-data-collection": "cross-env WALLETBEAT_ENV=HUMAN tsx src/tools/wallet-data-collection/wallet-data-collection-tool.ts",
		"wallet-data-collection:agent": "cross-env WALLETBEAT_ENV=AGENT tsx src/tools/wallet-data-collection/wallet-data-collection-tool.ts",
		"wallet-data-collection:ci": "cross-env WALLETBEAT_ENV=CI tsx src/tools/wallet-data-collection/wallet-data-collection-tool.ts"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/svelte": "^9.0.1",
		"@eslint/js": "^10.0.1",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@material-icons/svg": "^1.0.33",
		"@tanstack/match-sorter-utils": "^8.19.4",
		"@wagmi/core": "^3.6.4",
		"astro": "^7.1.6",
		"autoprefixer": "^10.5.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-unused-imports": "^4.4.1",
		"fflate": "^0.8.3",
		"lucide-static": "^0.562.0",
		"micromark": "^4.0.2",
		"postcss": "^8.5.25",
		"svelte": "5.56.8",
		"typescript-eslint": "^8.65.0",
		"wagmi": "3.7.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"@fleek-platform/cli": "^3.9.4",
		"@kindspells/astro-shield": "^1.7.1",
		"@types/prompts": "^2.4.9",
		"@xmldom/xmldom": "^0.9.10",
		"ajv": "^8.20.0",
		"cac": "^7.0.0",
		"chalk": "^6.0.0",
		"cross-env": "^10.1.0",
		"cspell": "10.0.1",
		"eslint": "10.8.0",
		"eslint-config-love": "^154.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sort-keys-custom-order": "^3.1.2",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"harper.js": "^0.61.0",
		"omnipin": "^3.1.1",
		"p-limit": "^7.3.1",
		"pnpm": "11.19.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-curly": "^0.4.1",
		"prompts": "^2.4.2",
		"remark": "^15.0.1",
		"remark-lint-no-literal-urls": "^4.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"sax": "^1.6.1",
		"svgo": "^4.0.2",
		"svgtofont": "^6.5.3",
		"tsx": "^4.23.1",
		"ttf2eot": "3.1.0",
		"ttf2woff": "3.0.0",
		"ttf2woff2": "8.0.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"prettier": {
		"singleQuote": true,
		"trailingComma": "all",
		"printWidth": 100,
		"tabWidth": 2,
		"semi": false,
		"jsxSingleQuote": true,
		"bracketSameLine": false,
		"arrowParens": "avoid",
		"endOfLine": "lf",
		"useTabs": true,
		"plugins": [
			"prettier-plugin-astro",
			"prettier-plugin-curly"
		]
	}
}
