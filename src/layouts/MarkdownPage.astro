---
// Types
type Props = {
	metadata: {
		title: string
		description?: string
	}
}

const { metadata } = Astro.props

// Layouts
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import { defaultNavigationItems } from '@/constants/navigation'
---

<Layout metadata={metadata}>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-content-page data-sticky-container data-column='gap-8'>
		<header data-scroll-item='inline-detached padding-match-start'>
			<hgroup data-column='gap-4'>
				<h1>{metadata.title}</h1>
			</hgroup>
		</header>

		<div data-prose data-scroll-item='inline-detached padding-match-end'>
			<slot />
		</div>
	</main>
</Layout>

<style>
	main {
		p {
			font-family: var(--fontFamily-avenir);
		}

		div :global(hr) {
			border: none;
			border-top: 1px solid var(--border);
			margin-block: 1rem;
		}

		h1,
		h2,
		h3 {
			font-family: var(--fontFamily-spMonorium);
		}
	}
</style>
