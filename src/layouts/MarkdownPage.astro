---
// Types
type Props = {
	metadata: {
		title: string
		description?: string
	}
}

const { metadata } = Astro.props

// Layouts
import PageLayout from '@/layouts/PageLayout.astro'
---

<PageLayout metadata={metadata} description={metadata.description}>
	<div data-prose data-scroll-item='inline-detached padding-match-end'>
		<slot />
	</div>
</PageLayout>
