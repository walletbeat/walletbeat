---
// Types
type Props = {
	metadata: {
		title: string
		description?: string
	}
}

const { metadata } = Astro.props

// Layouts
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import { defaultNavigationItems } from '@/constants/navigation'
---

<Layout metadata={metadata}>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-sticky-container data-column='gap-8'>
		<header data-scroll-item='inline-detached padding-match-start'>
			<hgroup data-column='gap-3'>
				<h1>{metadata.title}</h1>

				{metadata.description && <p>{metadata.description}</p>}
			</hgroup>
		</header>

		<div class='prose' data-scroll-item='inline-detached padding-match-end'>
			<slot />
		</div>
	</main>
</Layout>

<style>
	main {
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 52rem;
			--scrollItem-inlineDetached-maxPaddingMatchStart: 4rem;
			--scrollItem-inlineDetached-maxPaddingMatchEnd: 5rem;
		}

		hgroup {
			h1 {
				font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
				line-height: 1.15;
			}

			p {
				max-inline-size: 60ch;
				font-size: 1.125rem;
				line-height: 1.5;
				color: var(--text-secondary);
				text-wrap: pretty;
			}
		}
	}

	/*
	 * Long-form markdown. The global reset removes all margins, so vertical
	 * rhythm is restored here: generous space above headings, tighter below,
	 * and a readable measure for running text.
	 */
	.prose {
		---prose-measure: 70ch;
		---prose-codeBackground: color-mix(in srgb, var(--text-primary) 7%, transparent);
		---prose-dividerColor: color-mix(in srgb, var(--border-color) 70%, transparent);

		font-size: 1rem;
		line-height: 1.7;
		text-wrap: pretty;

		> :global(* + *) {
			margin-block-start: 1.1em;
		}

		> :global(meta:first-child + *) {
			margin-block-start: 0;
		}

		> :global(:is(p, ul, ol, blockquote, h2, h3, h4, h5, h6)) {
			max-inline-size: var(---prose-measure);
		}

		:global(h2) {
			margin-block-start: 2.75rem;
			padding-block-start: 1.5rem;
			border-block-start: 1px solid var(---prose-dividerColor);
			font-size: 1.5rem;
			line-height: 1.25;
		}

		/* The markdown pipeline can emit a <meta> before the first heading. */
		> :global(:is(h2:first-child, meta:first-child + h2)) {
			margin-block-start: 0;
			padding-block-start: 0;
			border-block-start: none;
		}

		:global(h3) {
			margin-block-start: 2rem;
			font-size: 1.2rem;
			line-height: 1.3;
		}

		:global(:is(h4, h5, h6)) {
			margin-block-start: 1.5rem;
			font-size: 1rem;
		}

		> :global(:is(h2, h3, h4, h5, h6) + *) {
			margin-block-start: 0.6em;
		}

		:global(:is(ul, ol)) {
			--list-gap: 0.4lh;
		}

		:global(li > :is(ul, ol)) {
			margin-block-start: 0.4lh;
		}

		:global(a) {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.2em;
			text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);

			&:hover {
				text-decoration-color: currentColor;
			}
		}

		:global(:not(pre) > code) {
			padding: 0.1em 0.35em;
			border-radius: 0.3em;
			background-color: var(---prose-codeBackground);
			font-size: 0.875em;
		}

		:global(pre) {
			overflow-x: auto;
			padding: 1em 1.25em;
			border-radius: 0.75rem;
			font-size: 0.8125rem;
			line-height: 1.6;
		}

		:global(blockquote) {
			padding-inline-start: 1em;
			border-inline-start: 3px solid var(---prose-dividerColor);
			color: var(--text-secondary);
		}

		:global(hr) {
			margin-block: 2.5rem;
			margin-inline: 0;
			border: none;
			border-block-start: 1px solid var(---prose-dividerColor);
		}

		/* Headings already draw a divider; don't double it after an explicit `---`. */
		> :global(hr + h2) {
			margin-block-start: 0;
			padding-block-start: 0;
			border-block-start: none;
		}

		:global(img) {
			max-inline-size: 100%;
			height: auto;
			border-radius: 0.5rem;
		}

		:global(table) {
			display: block;
			overflow-x: auto;
			border-collapse: collapse;
			font-size: 0.9375em;
		}

		:global(:is(th, td)) {
			padding: 0.5em 0.75em;
			border: 1px solid var(---prose-dividerColor);
			text-align: start;
			vertical-align: top;
		}

		:global(th) {
			background-color: var(---prose-codeBackground);
			font-weight: 600;
		}
	}
</style>
