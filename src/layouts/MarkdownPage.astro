---
// Types
type Props = {
	metadata: {
		title: string
		description?: string
	}
}

const { metadata } = Astro.props

// Layouts
import ContentPage from '@/layouts/ContentPage.astro'
---

<ContentPage metadata={metadata}>
	<div data-prose data-column='gap-3' data-scroll-item='inline-detached padding-match-end'>
		<slot />
	</div>
</ContentPage>
