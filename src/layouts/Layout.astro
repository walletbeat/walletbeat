---
// Global CSS
import '@/styles/global.css'
import '@/styles/css-attributes.css'
import '@/styles/wbicons.css'
import { navigationLogo } from '@/utils/navigation-logo'

// Props
import type { ComponentProps } from 'astro/types'
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

type Props = {
	metadata: ComponentProps<typeof Metadata>['metadata']

	/**
	 * If specified, rewrite URL to this as the page loads.
	 */
	rewriteUrlTo?: string

	/**
	 * Preload the `wbicons-complex` icon font.
	 * Only enable on pages that render complex icons above the fold.
	 */
	preloadComplexIcons?: boolean
}

const { metadata, rewriteUrlTo, preloadComplexIcons = false } = Astro.props

// Components
import Metadata from '@/layouts/Metadata.astro'
import Background from '@/components/Background.svelte'
import Footer from '@/views/Footer.astro'
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover' />
		<meta name='color-scheme' content='light dark' />
		<slot name='head' />
		<Metadata {metadata} />

		<Font cssVariable='--fontFamily-spaceGrotesk' preload />
		<Font cssVariable='--fontFamily-wbicons-complex' preload={preloadComplexIcons} />
		<Font cssVariable='--fontFamily-wbicons-simple' preload />
		<Font cssVariable='--fontFamily-avenir' preload />

		<ClientRouter />
		<script is:inline>
			;(() => {
				const systemDark = matchMedia('(prefers-color-scheme: dark)')
				let preference = null
				try {
					const stored = localStorage.getItem('theme')
					if (stored === 'light' || stored === 'dark') {
						preference = stored
					}
				} catch {
					/* Storage may be disabled; native control still works. */
				}
				function restoreTheme(doc = document) {
					const toggle = doc.getElementById('theme-toggle')
					if (toggle) {
						if (preference) {
							toggle.checked = (preference === 'dark') !== systemDark.matches
						}
						doc.documentElement.style.removeProperty('color-scheme')
					} else if (preference) {
						// First paint precedes the native control. Retire these when it exists.
						doc.documentElement.style.colorScheme = preference
					}
				}
				document.addEventListener('change', ({ target }) => {
					if (!(target instanceof HTMLInputElement) || target.id !== 'theme-toggle') {
						return
					}
					preference = target.checked !== systemDark.matches ? 'dark' : 'light'
					try {
						localStorage.setItem('theme', preference)
					} catch {
						/* Retain the choice in this document when storage is unavailable. */
					}
					restoreTheme()
				})
				systemDark.addEventListener('change', () => restoreTheme())
				document.addEventListener('DOMContentLoaded', () => restoreTheme(), { once: true })
				document.addEventListener('astro:before-swap', ({ newDocument }) =>
					restoreTheme(newDocument),
				)
				restoreTheme()
			})()
		</script>

		{
			rewriteUrlTo !== undefined && (
				<script is:inline define:vars={{ rewriteUrlTo }}>
					history.replaceState(null, '', rewriteUrlTo);
				</script>
			)
		}
	</head>
	<body>
		<Background
			blobs={{
				purple: {
					lightThemeColor: '#9333ea',
					darkThemeColor: '#8d1fec',
					opacity: { fromValue: '8%', toValue: '20%', seconds: 17.5 },
					translationX: { fromValue: '62%', toValue: '76%', seconds: 25 },
					translationY: { fromValue: '34%', toValue: '46%', seconds: 22.5 },
				},
				magenta: {
					lightThemeColor: '#d4a5ff',
					darkThemeColor: '#e895ff',
					opacity: { fromValue: '4%', toValue: '14%', seconds: 22.5 },
					translationX: { fromValue: '32%', toValue: '46%', seconds: 30 },
					translationY: { fromValue: '42%', toValue: '56%', seconds: 27.5 },
				},
				pink: {
					lightThemeColor: '#e7c8fb',
					darkThemeColor: '#eb88fc',
					opacity: { fromValue: '4%', toValue: '10%', seconds: 27.5 },
					translationX: { fromValue: '12%', toValue: '26%', seconds: 35 },
					translationY: { fromValue: '37%', toValue: '51%', seconds: 32.5 },
				},
				cyan: {
					lightThemeColor: '#f8edff',
					darkThemeColor: '#d1f4ff',
					opacity: { fromValue: '2%', toValue: '8%', seconds: 32.5 },
					translationX: { fromValue: '2%', toValue: '12%', seconds: 40 },
					translationY: { fromValue: '52%', toValue: '64%', seconds: 37.5 },
				},
			}}
		/>
		<div
			id='layout'
			style={`--navigation-logoAspectRatio: ${navigationLogo.width / navigationLogo.height}`}
			data-scroll-container
			data-sticky-container
		>
			<span class='page-start-snap' aria-hidden='true' hidden></span>
			<a class='skip-link' href='#content' data-astro-reload data-badge='large' data-row>
				<span data-icon={String.fromCodePoint(0x21b5)}></span>
				<span>Skip to main content</span>
			</a>
			<slot name='nav' />
			<div id='content' tabindex='-1' data-column='gap-0' data-sticky-container>
				<slot />
				<Footer />
			</div>
		</div>
	</body>
</html>

<style>
	/* Fixed metric timelines use viewport coordinates; content retains its native direction. */
	:root:has([data-sticky-breadcrumb~="root"]) {
		direction: ltr;
		body:dir(rtl) {
			direction: rtl;
		}
	}

	#layout {
		&:has(#nav-menu:is(:popover-open, [data-closing])) {
			overflow: hidden;
		}

		/* Constants */
		--navigation-desktop-inlineSize: min(20rem, 320px);
		--navigation-mobile-minBlockSize: 4.16rem;
		--navigation-mobile-blockSize: var(--navigation-mobile-minBlockSize);
		--navigation-controlInsetInline: 0.75rem;
		--navigation-logoBlockSize: 2.35rem;
		---navigation-logoInlineSize: calc(
			var(--navigation-logoBlockSize) * var(--navigation-logoAspectRatio)
		);
		--navigation-controlSize: 2rem;
		--navigation-controlGap: 0.5em;

		/* Rules */
		inline-size: 100%;
		block-size: 100dvh;
		padding: var(--safeArea-insetTop) var(--safeArea-insetRight) var(--safeArea-insetBottom)
			var(--safeArea-insetLeft);
		display: grid;
		align-items: start;
		gap: var(--separator-width);

		&[data-scroll-container] {
			--sticky-paddingBlockStart: var(--safeArea-insetTop);
			--sticky-paddingBlockEnd: var(--safeArea-insetBottom);
			--sticky-paddingInlineStart: var(--safeArea-insetLeft);
			--sticky-paddingInlineEnd: var(--safeArea-insetRight);
		}

		/* Two 20rem rails leave 40rem of content and 4rem of inline padding. */
		@media (width > 84rem) {
			grid-template:
				'Nav Content' minmax(0, 1fr)
				/ var(--navigation-desktop-inlineSize) minmax(0, 1fr);

			&[data-sticky-container] {
				--sticky-marginInlineStart: var(--separator-width);
				--sticky-paddingInlineStart: var(--navigation-desktop-inlineSize);
			}
		}

		@media (width <= 84rem) {
			grid-template:
				'Nav' var(--navigation-mobile-blockSize)
				'Content' minmax(0, 1fr)
				/ minmax(0, 1fr);

			&[data-sticky-container] {
				--sticky-marginBlockStart: var(--separator-width);
				--sticky-paddingBlockStart: var(--navigation-mobile-blockSize);
			}
		}

		> .skip-link {
			position: fixed;
			z-index: 3;
			inset: calc(var(--safeArea-insetTop) + 1rem) auto auto 50%;

			translate: -50% 0;
			transition-property: translate, opacity;

			&:not(:focus-visible) {
				opacity: 0;
				translate: -50% -150%;
			}
		}

		> nav {
			grid-area: Nav;
			box-shadow: 0 0 0 var(--separator-width) var(--border-color);
		}

		> #content {
			grid-area: Content;
			align-self: stretch;
			min-block-size: 0;
			min-inline-size: 0;

			@media (width <= 84rem) and (prefers-reduced-motion: no-preference) {
				&:not(:has([data-sticky-breadcrumb~="root"])) {
					transform-style: preserve-3d;
					transform: translateZ(0);
					transition-property: transform;

					nav:has(> #nav-menu:is(:popover-open, [data-closing])) ~ & {
						transform: translateZ(-2.5rem);
					}
				}
			}
		}
	}
</style>

<style is:global>
	@property --navigation-mobile-blockSize {
		syntax: '<length>';
		inherits: true;
		initial-value: 0px;
	}
	@property --navigation-controlGap {
		syntax: '<length>';
		inherits: true;
		initial-value: 0px;
	}
	@property ---wallet-chainWrap {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@keyframes wallet-scroll-entry {
		from {
			translate: 0 0;
		}
		to {
			translate: calc(
					var(---inlineDirection) * (var(---wallet-chainWrap) - 1) *
						(
							var(---breadcrumb-itemWidth) + var(--stickyBreadcrumb-markerSize) +
								var(--stickyBreadcrumb-gap, 1rem)
						) /
						2
				)
				calc(-1 * var(---wallet-chainWrap) * var(--navigation-mobile-blockSize));
		}
	}
	#layout:has([data-sticky-breadcrumb~="root"]) {
		position: relative;

		> .page-start-snap {
			position: absolute;
			inset-block-start: 0;
			inset-inline-start: 0;
			display: block;
			inline-size: 1px;
			block-size: 1px;
			scroll-snap-align: start;
			pointer-events: none;
		}

		---wallet-name-flow-font-size: 2.25rem;
		---wallet-compact-h1: 1.5rem;
		--stickyBreadcrumb-markerSize: 1.25rem;
		timeline-scope: --wallet-end-inline, --wallet-end-block;
	}
	/* The site logo and wallet identity share native widths and arrival at Layout. */
	@supports (animation-timeline: scroll()) and (animation-range: 0% 100%) and
		(width: anchor-size(--breadcrumb-source inline)) and (timeline-scope: --breadcrumb-size) and
		(color: if(style(---breadcrumb-wrap: 1): red; else: blue)) {
		#layout:has([data-sticky-breadcrumb~="root"]) {
			timeline-scope:
				--wallet-end-inline, --wallet-end-block, --wallet-item-inline, --wallet-item-block;
			@supports (timeline-scope: all) and (view-timeline-name: ident('a' 'b')) {
				timeline-scope: --wallet-end-inline, --wallet-end-block;
			}
			animation:
				breadcrumb-item-inline auto linear reverse both,
				breadcrumb-item-block auto linear reverse both;
			animation-timeline: --wallet-item-inline, --wallet-item-block;
			animation-range: exit-crossing 0% exit-crossing 100%;
			---breadcrumb-itemWidth: round(
				up,
				calc(100vw * (1 / var(---breadcrumb-itemInline) - 1)),
				0.0625px
			);
			---breadcrumb-naturalItemHeight: calc(100vw * (1 / var(---breadcrumb-itemBlock) - 1));
			---breadcrumb-itemHeight: round(nearest, var(---breadcrumb-naturalItemHeight), 0.0625px);
		}
		@media (width <= 84rem) {
			#layout:has([data-sticky-breadcrumb~="root"]) {
				---navigation-controlsInlineSize: calc(
					2 * var(--navigation-controlSize) + var(--navigation-controlGap)
				);
				/* Both-ended Expo reaches its midpoint at 25% so identity text clears before rising. */
				---navigation-entryEasing: linear(
					0,
					0.000977 2.5%,
					0.001953 5%,
					0.003906 7.5%,
					0.007812 10%,
					0.015625 12.5%,
					0.03125 15%,
					0.0625 17.5%,
					0.125 20%,
					0.25 22.5%,
					0.5 25%,
					0.75 32.5%,
					0.875 40%,
					0.9375 47.5%,
					0.96875 55%,
					0.984375 62.5%,
					0.992188 70%,
					0.996094 77.5%,
					0.998047 85%,
					0.999023 92.5%,
					1
				);
				--navigation-mobile-blockSize: max(
					var(--navigation-mobile-minBlockSize),
					calc(
						var(---breadcrumb-naturalItemHeight) * var(---wallet-compact-h1) /
							var(---wallet-name-flow-font-size) + 2 * var(--stickyBreadcrumb-paddingBlock, 0.5rem)
					)
				);
				timeline-scope:
					--wallet-item-inline, --wallet-item-block, --wallet-end-inline, --wallet-end-block,
					--wallet-entry;
				@supports (timeline-scope: all) and (view-timeline-name: ident('a' 'b')) {
					timeline-scope: --wallet-entry;
				}
			}
			#layout:has([data-sticky-breadcrumb~="root"])
				[data-sticky-breadcrumb~="root"][data-sticky-breadcrumb~="scope"] {
				--stickyBreadcrumb-insetBlockStart: 0px;
				---breadcrumb-parentBlockEnd: var(--navigation-mobile-blockSize);
			}
			#layout:has([data-sticky-breadcrumb~="root"])
				[data-sticky-breadcrumb~="root"]
				> [data-sticky-breadcrumb~="position"] {
				--sticky-insetBlockStart: var(--navigation-mobile-blockSize);
				--stickyBreadcrumb-inlineEasing: var(---navigation-entryEasing);
			}
			/* The navigation owns the surface shared by the mobile identity row. */
			#layout:has([data-sticky-breadcrumb~="root"])
				[data-sticky-breadcrumb~="root"]
				> [data-sticky-breadcrumb~="position"]::after {
				display: none;
			}
			#layout:has([data-sticky-breadcrumb~="root"]) [data-sticky-breadcrumb~="root"] > * {
				---breadcrumb-blockStart: var(--stickyBreadcrumb-insetBlockStart);
				---breadcrumb-blockEnd: var(--navigation-mobile-blockSize);
				---breadcrumb-width: var(---breadcrumb-itemWidth);
				---breadcrumb-height: var(---breadcrumb-compactItemHeight);
			}
			#layout:has([data-sticky-breadcrumb~="root"]) #nav > header {
				animation: breadcrumb-end-inline auto linear both;
				animation-timeline: --wallet-end-inline;
				---breadcrumb-itemWidth: inherit;
				---breadcrumb-endWidth: round(
					up,
					calc(100vw * (1/var(---breadcrumb-endInline) - 1)),
					0.0625px
				);
			}
			#layout:has([data-sticky-breadcrumb~="root"]) #nav > header,
			#layout:has([data-sticky-breadcrumb~="root"])
				[data-sticky-breadcrumb~="root"]
				> [data-sticky-breadcrumb~="position"]
				[data-sticky-breadcrumb~="source"] {
				---wallet-chainWrap: clamp(
					0,
					sign(
						var(---navigation-logoInlineSize) + var(--stickyBreadcrumb-markerSize) +
							var(--stickyBreadcrumb-gap, 1rem) + var(---breadcrumb-itemWidth) + 2 *
							(
								var(--navigation-controlInsetInline) +
									max(
										var(---navigation-controlsInlineSize),
										2rem + 0.5rem + var(---breadcrumb-endWidth)
									)
							) -
							100vw
					),
					1
				);
			}
			#layout:has([data-sticky-breadcrumb~="root"]) #nav {
				--sticky-zIndex: 2;
			}
			#layout:has([data-sticky-breadcrumb~="root"]) {
				#nav > header > .logo {
					animation: wallet-scroll-entry auto var(---navigation-entryEasing) both;
					animation-timeline: --wallet-entry;
					animation-range: contain 0% contain 100%;
					@media (prefers-reduced-motion: reduce) {
						animation-timing-function: steps(1, end);
					}
				}
				&:is(
						[data-wallet-toc-state="open"],
						[data-wallet-toc-state="closing"],
						:has(#nav-menu:is(:popover-open, [data-closing]))
					)
					#nav
					> header
					> .logo {
					animation-range: cover calc(0% - var(--safeArea-insetTop)) cover
						calc(0% - var(--safeArea-insetTop));
				}
			}
			#layout:has([data-sticky-breadcrumb~="root"])
				[data-sticky-breadcrumb~="root"]
				> [data-sticky-breadcrumb~="position"]
				[data-sticky-breadcrumb~="item"] {
				---breadcrumb-translateInline: calc(
					var(---inlineDirection) *
						(
							(
									100vw - var(---breadcrumb-itemWidth) + (1 - var(---wallet-chainWrap)) *
										(
											var(---navigation-logoInlineSize) + var(--stickyBreadcrumb-markerSize) +
												var(--stickyBreadcrumb-gap, 1rem)
										)
								) /
								2 - var(--scrollItem-paddingInlineStart)
						)
				);
				---breadcrumb-translateBlock: calc(
					-1 * var(--sticky-insetBlockStart) +
						(
							(
									var(--navigation-mobile-blockSize) - var(---breadcrumb-itemHeight) *
										var(--stickyBreadcrumb-scale)
								) /
								2 - var(--stickyBreadcrumb-sourcePaddingBlock) -
								(1 - var(---breadcrumb-sourceEndWrap)) *
								(var(---breadcrumb-sourceRowHeight) - var(---breadcrumb-itemHeight)) / 2
						)
				);
			}
			#layout:is(
					[data-wallet-toc-state="open"],
					[data-wallet-toc-state="closing"],
					:has(#nav-menu:is(:popover-open, [data-closing]))
				)
				[data-sticky-breadcrumb~="root"]
				> [data-sticky-breadcrumb~="position"] {
				:is([data-sticky-breadcrumb~="item"], [data-sticky-breadcrumb~="end"]) {
					---breadcrumb-entry: 1;
				}
				[data-sticky-breadcrumb~="item"] {
					--stickyBreadcrumb-entryRange: cover calc(0% - var(--safeArea-insetTop)) cover
						calc(0% - var(--safeArea-insetTop));
				}
			}

			#layout:has([data-sticky-breadcrumb~="root"])
				[data-sticky-breadcrumb~="root"]
				> [data-sticky-breadcrumb~="position"]
				.wallet-name {
				---breadcrumb-markerWrap: var(---wallet-chainWrap);
			}
		}
	}
</style>

<script>
	import type { TransitionBeforePreparationEvent } from 'astro:transitions/client'
	import walletSelectionDestination from '@/views/wallet-selection-destination.js'
	document.addEventListener(
		'astro:before-preparation',
		(event: TransitionBeforePreparationEvent) => {
			const originalLoader = event.loader
			event.loader = async () => {
				await originalLoader()
				if (event.defaultPrevented || event.signal.aborted || event.formData) {
					return
				}
				const target = walletSelectionDestination(event.newDocument, event.to)
				if (!target) {
					return
				}
				const canonical = event.to
				event.to = target
				try {
					await originalLoader()
				} finally {
					event.to = canonical
				}
			}
		},
	)
</script>
