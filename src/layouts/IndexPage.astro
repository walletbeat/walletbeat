---
// Types
import type { IndexEntry } from '@/utils/collection-utils'

type Metadata = {
	title: string
	description: string
}

type Props = {
	metadata: Metadata
	entries: IndexEntry[]
	currentDir: string
	urlPrefix: string
	parentUrl?: string
}

const { metadata, entries, parentUrl } = Astro.props

// Layouts
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import { defaultNavigationItems } from '@/constants/navigation'
---

<Layout metadata={metadata}>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-sticky-container data-column='gap-8'>
		<header data-scroll-item='inline-detached padding-match-start' data-column='gap-4'>
			{
				parentUrl && (
					<nav aria-label='Breadcrumb'>
						<a href={parentUrl}>← Back</a>
					</nav>
				)
			}

			<hgroup data-column='gap-3'>
				<h1>{metadata.title}</h1>

				{metadata.description && <p>{metadata.description}</p>}
			</hgroup>
		</header>

		{
			entries.length > 0 ? (
				<div data-scroll-item='inline-detached padding-match-end'>
					<div class='index-grid'>
						{entries.map(entry => (
							<a class='index-card' href={entry.path}>
								<div class='index-card-content'>
									<h2>{entry.title}</h2>

									{entry.description && <p>{entry.description}</p>}
								</div>

								<span class='index-card-arrow' aria-hidden='true'>
									→
								</span>
							</a>
						))}
					</div>
				</div>
			) : (
				<div data-scroll-item='inline-detached padding-match-end'>
					<p>No pages in this directory.</p>
				</div>
			)
		}
	</main>
</Layout>

<style>
	main {
		/* Same column and header as MarkdownPage, so moving between index and article keeps the left edge. */
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 52rem;
			--scrollItem-inlineDetached-maxPaddingMatchStart: 4rem;
			--scrollItem-inlineDetached-maxPaddingMatchEnd: 5rem;
		}

		line-height: 1.4;

		hgroup {
			h1 {
				font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
				line-height: 1.15;
			}

			p {
				max-inline-size: 60ch;
				font-size: 1.125rem;
				line-height: 1.5;
				color: var(--text-secondary);
				text-wrap: pretty;
			}
		}

		nav a {
			font-size: 0.875rem;
			color: var(--text-secondary);
			text-decoration: none;

			&:hover {
				color: var(--text-primary);
			}
		}
	}

	.index-grid {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
	}

	.index-card {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid color-mix(in srgb, var(--border-color) 70%, transparent);
		border-radius: 0.75rem;
		background-color: var(--background-secondary);
		text-decoration: none;
		color: var(--text-primary);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;

		&:hover {
			border-color: color-mix(in srgb, var(--accent) 50%, var(--border-color));
			box-shadow: 0 8px 24px -12px rgb(19 10 43 / 0.2);
			text-decoration: none;
		}
	}

	.index-card-content {
		flex: 1;
		min-width: 0;
	}

	.index-card-content h2 {
		margin: 0 0 0.25rem;
		font-size: 1.125rem;
	}

	.index-card-content p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.5;
		font-weight: 400;
		color: var(--text-secondary);
	}

	.index-card-arrow {
		flex-shrink: 0;
		font-size: 1.25rem;
		color: var(--text-secondary);
		transition: color 0.15s ease;
	}

	.index-card:hover .index-card-arrow {
		color: var(--accent);
	}
</style>
