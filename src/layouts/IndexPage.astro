---
// Types
import type { IndexEntry } from '@/utils/collection-utils'

type Metadata = {
	title: string
	description: string
}

type Props = {
	metadata: Metadata
	entries: IndexEntry[]
	currentDir: string
	urlPrefix: string
	parentUrl?: string
}

const { metadata, entries, parentUrl } = Astro.props

// Layouts
import ContentPage from '@/layouts/ContentPage.astro'
---

<ContentPage
	metadata={metadata}
	description={metadata.description}
	style={{ '--scrollItem-inlineDetached-maxSize': '72rem' }}
>
	{
		parentUrl && (
			<nav data-scroll-item='inline-detached padding-match-start'>
				<a href={parentUrl}>← Back</a>
			</nav>
		)
	}

	{
		entries.length > 0 ? (
			<div data-scroll-item='inline-detached padding-match-end'>
				<div class='index-grid'>
					{entries.map(entry => (
						<a
							data-card='secondary padding-5'
							data-row='align-start'
							data-link='camouflaged'
							href={entry.path}
						>
							<div data-row-item='flexible' data-column='gap-1'>
								<h2>{entry.title}</h2>

								{entry.description && <p>{entry.description}</p>}
							</div>

							<span aria-hidden='true'>→</span>
						</a>
					))}
				</div>
			</div>
		) : (
			<div data-scroll-item='inline-detached padding-match-end'>
				<p>No pages in this directory.</p>
			</div>
		)
	}
</ContentPage>

<style>
	nav a {
		font-size: 0.875rem;
	}

	.index-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
	}

	a[data-card] {
		h2 {
			font-size: 1.125rem;
		}

		p {
			font-size: 0.875rem;
		}
	}
</style>
