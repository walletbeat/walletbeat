---
import { topbarNavigationItems } from '@/constants/navigation'
---

<header id='topbar'>
	<a href='/' class='brand'>
		<img class='logo-for-light' src='/logo-dark.svg' alt='Walletbeat' />
		<img class='logo-for-dark' src='/logo-light.svg' alt='Walletbeat' />
	</a>

	<nav>
		{
			topbarNavigationItems.map(({ href, icon, title }) => {
				const external = href?.startsWith('http')

				return (
					<a href={href} {...(external ? { target: '_blank', rel: 'noreferrer' } : {})}>
						<span class='icon'>{icon && <span data-icon={`wbicons ${icon}`} />}</span>
						<span class='label'>{title}</span>
					</a>
				)
			})
		}
	</nav>
</header>

<style>
	#topbar {
		grid-area: Header;
		background-color: var(--background-primary);
		/* Blurs the background gradient behind the bar */
		backdrop-filter: blur(20px);
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 2rem;

		&::after {
			content: '';
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			height: 1px;
			background-color: var(--navigation-borderColor);
		}

		.brand {
			display: flex;
			align-items: center;
			text-decoration: none;

			img {
				display: block;
				height: 3rem;
			}

			/* Light mode: show dark logo */
			.logo-for-dark {
				display: none;
			}

			/* Dark mode via system preference */
			@media (prefers-color-scheme: dark) {
				:global(html:not([style*='color-scheme: light'])) & .logo-for-dark {
					display: block;
				}
				:global(html:not([style*='color-scheme: light'])) & .logo-for-light {
					display: none;
				}
			}

			/* Dark mode via manual JS toggle */
			:global(html[style*='color-scheme: dark']) & .logo-for-dark {
				display: block;
			}
			:global(html[style*='color-scheme: dark']) & .logo-for-light {
				display: none;
			}
		}
		span svg {
			width: 1.5em;
			height: 1.5em;
		}

		nav {
			display: flex;
			align-items: center;
			gap: 0.5rem;

			a {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.375rem;
				padding: 0.25rem 0.5rem;
				text-decoration: none;
				color: inherit;

				.icon {
					display: flex;
					align-items: center;
					justify-content: center;
					font-size: 1.75rem;
					font-weight: 500;
					width: 3rem;
					height: 3rem;
					border-radius: 50%;
					border: 1px solid var(--icon-navigation-borderColor);

					:global(svg) {
						width: 1.25rem;
						height: 1.25rem;
					}
				}

				.label {
					font-size: 0.75rem;
					color: var(--text-secondary);
				}

				&:hover .icon {
					background-color: var(--accent-backgroundColor);
				}
			}
		}
	}

	@media (max-width: 1024px) {
		#topbar {
			display: none;
		}
	}
</style>
