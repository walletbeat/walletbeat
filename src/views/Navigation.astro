---
import type { NavigationItem } from '@/constants/navigation'
import {
	navigationAbout,
	navigationFaq,
	navigationFarcasterChannel,
	navigationRepository,
	navigationTwitter,
} from '@/constants/navigation'
import NavigationItems from './NavigationItems.svelte'
import LuMenu from 'lucide-static/icons/menu.svg?raw'
import LuMoon from 'lucide-static/icons/moon.svg?raw'
import LuSun from 'lucide-static/icons/sun.svg?raw'

interface Props {
	navigationItems: NavigationItem[]
}

const { navigationItems } = Astro.props
const currentPathname = Astro.url.pathname
const secondaryNavigationItems = [
	navigationAbout,
	navigationFaq,
	navigationRepository,
	navigationTwitter,
	navigationFarcasterChannel,
] satisfies NavigationItem[]
---

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		document.documentElement.style.colorScheme =
			document.documentElement.style.colorScheme === 'dark' ? 'light' : 'dark'
		localStorage.setItem('theme', document.documentElement.style.colorScheme)
		document
			.querySelector('meta[name="color-scheme"]')
			?.setAttribute('content', document.documentElement.style.colorScheme)
	})
</script>

<nav
	id='nav'
	popover='auto'
	data-column='gap-0'
	data-sticky='backdrop-self backdrop-always'
	data-scroll-container
	data-sticky-container
>
	<header data-sticky='backdrop-self backdrop-always' data-row>
		<a href='/' class='navigation-logo'>
			<img src='/logo.svg' alt='Walletbeat Logo' />
		</a>

		<menu data-row='gap-2'>
			<li>
				<button type='button' id='theme-toggle' data-icon='circle' data-stack>
					<span set:html={LuSun} />
					<span set:html={LuMoon} />
				</button>
			</li>

			<li>
				<button type='button' id='menu-toggle' data-icon='circle' popovertarget='nav'>
					<span set:html={LuMenu} />
				</button>
			</li>
		</menu>
	</header>

	<div id='nav-menu' data-column data-column-item='flexible' data-sticky-container>
		<NavigationItems
			client:load
			transition:persist
			items={navigationItems}
			groups={[{ items: navigationItems }, { items: secondaryNavigationItems }]}
			currentPathname={currentPathname}
		/>

		<footer data-card data-sticky='backdrop-self backdrop-always' data-sticky-container>
			<p>
				Wallets listed on Walletbeat do not represent endorsements and are for informational
				purposes only.
			</p>
		</footer>
	</div>
</nav>

<style>
	nav {
		width: 100%;
		height: 100dvh;

		&[data-sticky][data-sticky] {
			--sticky-backgroundColor: color-mix(in oklch, var(--background-primary) 90%, transparent);
		}

		> header {
			block-size: var(--navigation-mobile-blockSize);
			box-shadow: inset 0 calc(-1 * var(--separator-width)) 0 var(--border-color);
			padding: 1rem;

			.navigation-logo {
				display: flex;
				text-decoration: none;

				img {
					display: block;
					height: 2.35rem;
				}
			}

			menu {
				li {
					display: contents;
				}

				button {
					svg {
						transition-property: color;
					}
				}

				#theme-toggle {
					> :first-child {
						color: light-dark(currentColor, transparent);
					}
					> :last-child {
						color: light-dark(transparent, currentColor);
					}
				}
			}
		}

		#nav-menu {
			--navigation-footer-sidestepBlock: 1rem;

			position: relative;
			z-index: 0;
			align-content: stretch;
			min-block-size: max-content;
			padding: 1rem 0.75rem;

			&[data-sticky-container] {
				--sticky-marginBlockStart: var(--navigation-mobile-blockSize);
				--sticky-paddingBlockStart: 1rem;
				--sticky-paddingBlockEnd: var(--navigation-footer-sidestepBlock);
				--sticky-paddingInlineStart: 0.75rem;
				--sticky-paddingInlineEnd: 0.75rem;
			}

			footer {
				&[data-card] {
					--card-backgroundColor: color-mix(
						in oklch,
						var(--background-secondary) 82%,
						var(--accent)
					);

					p {
						line-height: 1.4;
						font-size: 0.875rem;
						color: var(--text-secondary);
					}
				}
			}
		}
	}

	@media (min-width: 1025px) {
		nav:not(:popover-open) li:has(#menu-toggle) {
			display: none;
		}
	}

	@media (max-width: 1024px) {
		#nav {
			--navigation-menu-maskFade: 9rem;

			clip-path: inset(0 0 calc(100% - var(--navigation-mobile-blockSize)) 0);
			transition-property:
				background-color,
				-webkit-backdrop-filter,
				backdrop-filter,
				clip-path,
				display,
				overlay;
			transition-behavior: allow-discrete;

			block-size: 100dvh;
			height: 100dvh;
			transform-style: preserve-3d;

			#nav-menu {
				.navigation-note {
					display: block;
					order: 3;
					margin-block-start: 1rem;
				}

				> footer {
					display: none;
				}
			}

			header ~ * {
				filter: blur(0);
				mask-image: linear-gradient(
					to bottom,
					black calc(100% - var(--navigation-menu-maskFade)),
					transparent
				);
				mask-position: top;
				mask-repeat: no-repeat;
				mask-size: 100% calc(100% + var(--navigation-menu-maskFade));
				opacity: 1;
				translate: 0 0 0;
				transition-property: filter, opacity, translate, mask-size, display, overlay;
				transition-behavior: allow-discrete;
				transform-style: preserve-3d;
			}

			.navigation-items > label {
				transition-property: translate;
			}

			&:not(:popover-open) {
				overscroll-behavior: none;

				header ~ * {
					display: none;
					filter: blur(0.375rem);
					interactivity: inert;
					mask-size: 100% 0;
					opacity: 0;
					translate: 0 -0.75rem 1.25rem;
					pointer-events: none;
				}

				.navigation-items > label {
					transition-delay: 0s;
					translate: 0 1.75rem 1.25rem;
				}
			}

			&:popover-open {
				clip-path: inset(0);

				.navigation-items > label {
					transition-delay: 0.08s;
				}

				@starting-style {
					clip-path: inset(0 0 calc(100% - var(--navigation-mobile-blockSize)) 0);

					header ~ * {
						filter: blur(0.375rem);
						mask-size: 100% 0;
						opacity: 0;
						translate: 0 -0.75rem 1.25rem;
					}

					.navigation-items > label {
						translate: 0 1.75rem 1.25rem;
					}
				}
			}
		}

		@media (prefers-reduced-motion: reduce) {
			nav,
			nav header ~ * {
				translate: 0 0 0;
			}
		}
	}
</style>
