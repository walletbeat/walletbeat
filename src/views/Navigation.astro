---
import type { NavigationItem } from '@/constants/navigation'
import {
	navigationAbout,
	navigationFaq,
	navigationFarcasterChannel,
	navigationRepository,
	navigationTwitter,
} from '@/constants/navigation'
import NavigationItems from './NavigationItems.svelte'
import LuMenu from 'lucide-static/icons/menu.svg?raw'
import LuMoon from 'lucide-static/icons/moon.svg?raw'
import LuSun from 'lucide-static/icons/sun.svg?raw'

interface Props {
	navigationItems: NavigationItem[]
	currentHref?: string
}

const { navigationItems, currentHref = Astro.url.pathname } = Astro.props
const secondaryNavigationItems = [
	navigationAbout,
	navigationFaq,
	navigationRepository,
	navigationTwitter,
	navigationFarcasterChannel,
] satisfies NavigationItem[]
---

<nav
	id='nav'
	aria-label='Site'
	data-column='gap-0'
	data-sticky='backdrop-none'
	data-sticky-container
>
	<header data-sticky='backdrop-self backdrop-always' data-row>
		<a href='/' class='logo'>
			<img
				src='/logo.svg'
				alt='Walletbeat'
				width='516'
				height='126'
				data-safari='invert-lightness'
			/>
		</a>

		<menu data-row='gap-2'>
			<li>
				<button
					type='button'
					id='menu-toggle'
					aria-label='Open navigation menu'
					data-icon='circle'
					popovertarget='nav-menu'
				>
					<span set:html={LuMenu} />
				</button>
			</li>

			<li>
				<label data-icon='circle' data-stack title='Toggle color theme'>
					<input type='checkbox' id='theme-toggle' aria-label='Use opposite color theme' />
					<span aria-hidden='true' set:html={LuSun} />
					<span aria-hidden='true' set:html={LuMoon} />
				</label>
			</li>
		</menu>
	</header>

	<div
		id='nav-menu'
		popover='auto'
		data-scroll-container='block'
		data-sticky='block backdrop-self backdrop-always'
		data-column
		data-column-item='flexible'
		data-sticky-container
	>
		<NavigationItems
			client:load
			transition:persist
			items={navigationItems}
			groups={[{ items: navigationItems }, { items: secondaryNavigationItems }]}
			currentHref={currentHref}
		/>
	</div>
</nav>

<script>
	import { finishPopoverExit } from './popover-transition'

	let closing: symbol | null = null

	document.addEventListener(
		'beforetoggle',
		event => {
			const panel = event.target

			if (!(panel instanceof HTMLElement) || panel.id !== 'nav-menu') {
				return
			}
			closing = event.newState === 'closed' ? Symbol() : null
			panel.toggleAttribute('data-closing', closing !== null)
		},
		true,
	)
	document.addEventListener(
		'toggle',
		async event => {
			const panel = event.target
			const token = closing

			if (!(panel instanceof HTMLElement) || panel.id !== 'nav-menu' || token === null) {
				return
			}
			await finishPopoverExit(panel)
			if (closing === token && !panel.matches(':popover-open')) {
				closing = null
				panel.removeAttribute('data-closing')
			}
		},
		true,
	)
</script>

<style>
	nav {
		&:not(:has(> #nav-menu:popover-open)) > #nav-menu[data-scroll-container] {
			overscroll-behavior: auto;
		}

		width: 100%;
		height: 100dvh;

		&[data-sticky][data-sticky] {
			--sticky-offset: 0px;
			--sticky-backgroundColor: color-mix(in oklch, var(--background-primary) 90%, transparent);
		}

		> header {
			block-size: var(--navigation-mobile-blockSize);
			box-shadow: inset 0 calc(-1 * var(--separator-width)) 0 var(--border-color);
			padding: 1rem;

			.logo {
				display: flex;
				text-decoration: none;

				img {
					display: block;
					width: auto;
					height: 2.35rem;
				}
			}

			menu {
				li {
					display: contents;
				}

				button {
					svg {
						transition-property: color;
					}
				}

				label:has(> #theme-toggle) {
					> input {
						position: absolute;
						inset: 0;
						inline-size: 100%;
						block-size: 100%;
						opacity: 0;
					}

					> span:first-of-type {
						color: light-dark(currentColor, transparent);
					}
					> :last-child {
						color: light-dark(transparent, currentColor);
					}
				}
			}
		}

		#nav-menu {
			--sticky-offset: initial;
			inline-size: 100%;
			position: relative;
			z-index: 0;
			align-content: stretch;
			min-block-size: 0;
			padding: 1rem 0.75rem;
		}
	}

	@media (width > 1024px) {
		nav:not(:has(> #nav-menu:popover-open)) li:has(#menu-toggle) {
			display: none;
		}
	}

	@media (width <= 1024px) {
		#nav {
			--navigation-menu-maskFade: 9rem;

			block-size: var(--navigation-mobile-blockSize);
			height: var(--navigation-mobile-blockSize);

			> header {
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;

				.logo {
					grid-area: 1 / 2;
					justify-self: center;
				}

				menu {
					grid-area: 1 / 1;
					justify-self: start;
				}
			}

			#nav-menu {
				.navigation-note {
					display: block;
					order: 3;
					margin-block-start: 1rem;
				}
			}

			#nav-menu {
				position: fixed;
				inset: var(--navigation-mobile-blockSize) 0 0;
				block-size: auto;
				filter: blur(0);
				mask-image: linear-gradient(
					to bottom,
					black calc(100% - var(--navigation-menu-maskFade)),
					transparent
				);
				mask-position: top;
				mask-repeat: no-repeat;
				mask-size: 100% calc(100% + var(--navigation-menu-maskFade));
				opacity: 1;
				translate: 0 0 0;
				transition-property: filter, opacity, translate, mask-size, display, overlay;
				transition-behavior: allow-discrete;
				transform-style: preserve-3d;
			}

			.navigation-items > label {
				transition-property: translate;
			}

			&:not(:has(> #nav-menu:popover-open)) {
				#nav-menu {
					display: none;
					filter: blur(0.375rem);
					interactivity: inert;
					mask-size: 100% 0;
					opacity: 0;
					translate: 0 -0.75rem 1.25rem;
					pointer-events: none;
				}

				.navigation-items > label {
					transition-delay: 0s;
					translate: 0 1.75rem 1.25rem;
				}
			}

			&:has(> #nav-menu:popover-open) {
				.navigation-items > label {
					transition-delay: 0.08s;
				}

				@starting-style {
					#nav-menu {
						filter: blur(0.375rem);
						mask-size: 100% 0;
						opacity: 0;
						translate: 0 -0.75rem 1.25rem;
					}

					.navigation-items > label {
						translate: 0 1.75rem 1.25rem;
					}
				}
			}
		}

		@media (prefers-reduced-motion: reduce) {
			nav,
			nav #nav-menu {
				translate: 0 0 0;
			}
		}
	}

	@media (width <= 1024px) {
		:global(body:has([data-sticky-breadcrumb~="root"])) #nav > header {
			anchor-name: --navigation-row;
		}
	}
</style>
