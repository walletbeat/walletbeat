---
import type { NavigationItem } from '@/constants/navigation'
import { topbarNavigationItems } from '@/constants/navigation'
import NavigationItems from './NavigationItems.svelte'
import MenuIcon from 'lucide-static/icons/menu.svg?raw'
import XIcon from 'lucide-static/icons/x.svg?raw'
import SunMoonIcon from 'lucide-static/icons/sun-moon.svg?raw'

interface Props {
	navigationItems: NavigationItem[]
}

const { navigationItems } = Astro.props
const currentPathname = Astro.url.pathname
---

<nav
	id='nav'
	popover='auto'
	data-sticky='backdrop-always'
	data-scroll-container
	data-sticky-container
>
	<!-- Mobile-only: collapsed top bar (logo center, hamburger right) -->
	<div id='nav-collapsed-bar'>
		<a href='/' class='nav-collapsed-logo' aria-label='Walletbeat'>
			<img class='logo-for-light' src='/logo-dark.svg' alt='Walletbeat' />
			<img class='logo-for-dark' src='/logo-light.svg' alt='Walletbeat' />
		</a>
		<button id='nav-hamburger' aria-label='Open navigation'>
			<Fragment set:html={MenuIcon} />
		</button>
	</div>

	<div id='nav-menu' data-sticky-container>
		<!-- Mobile-only: sidebar header with logo, theme toggle, close button -->
		<div class='nav-sidebar-header'>
			<a href='/' class='nav-sidebar-logo' aria-label='Walletbeat'>
				<img class='logo-for-light' src='/logo-dark.svg' alt='Walletbeat' />
				<img class='logo-for-dark' src='/logo-light.svg' alt='Walletbeat' />
			</a>
			<div class='nav-sidebar-actions'>
				<button id='nav-close-btn' aria-label='Close navigation'>
					<Fragment set:html={XIcon} />
				</button>
			</div>
		</div>

		<NavigationItems
			client:idle
			transition:persist
			items={navigationItems}
			currentPathname={currentPathname}
		/>

		<!-- Mobile-only: topbar links (about, faq, code, farcaster) -->
		<div class='nav-topbar-section'>
			<hr class='nav-section-divider' />
			<NavigationItems
				client:idle
				items={topbarNavigationItems}
				currentPathname={currentPathname}
				showSearch={false}
			/>
		</div>

		<!-- Theme toggle — shown in sidebar on both mobile and desktop -->
		<div class='nav-theme-footer'>
			<button class='nav-theme-btn' id='nav-theme-btn-sidebar' aria-label='Toggle theme'>
				<Fragment set:html={SunMoonIcon} />
				<span>Toggle theme</span>
			</button>
		</div>
	</div>
</nav>

<script>
	function toggleTheme() {
		const current = document.documentElement.style.colorScheme
		const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
		const resolved = current || system
		const next = resolved === 'dark' ? 'light' : 'dark'
		document.documentElement.style.colorScheme = next
		localStorage.setItem('theme', next)
	}

	function setupMobileNav() {
		const nav = document.getElementById('nav') as
			| (HTMLElement & {
					showPopover?: () => void
					hidePopover?: () => void
			  })
			| null
		const hamburger = document.getElementById('nav-hamburger')
		const closeBtn = document.getElementById('nav-close-btn')

		hamburger?.addEventListener('click', () => nav?.showPopover?.())
		closeBtn?.addEventListener('click', () => nav?.hidePopover?.())

		document
			.querySelectorAll<HTMLButtonElement>('.nav-theme-btn')
			.forEach(btn => btn.addEventListener('click', toggleTheme))
	}

	setupMobileNav()
	document.addEventListener('astro:after-swap', setupMobileNav)
</script>

<style>
	nav {
		width: 100%;
		height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr;
		border-right: 1px solid var(--navigation-borderColor);

		#nav-menu {
			padding: 1rem 0.75rem 1rem 1.5rem;

			&[data-sticky-container] {
				--sticky-marginBlockStart: 1rem;
				--sticky-marginBlockEnd: 1rem;
				--sticky-marginInlineStart: 0.75rem;
				--sticky-marginInlineEnd: 0.75rem;

				--sticky-paddingBlockStart: 3rem;
			}
		}
	}

	/* Logo switching for both collapsed bar and sidebar */
	.nav-collapsed-logo .logo-for-dark,
	.nav-sidebar-logo .logo-for-dark {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(html:not([style*='color-scheme: light'])) .nav-collapsed-logo .logo-for-dark,
		:global(html:not([style*='color-scheme: light'])) .nav-sidebar-logo .logo-for-dark {
			display: block;
		}
		:global(html:not([style*='color-scheme: light'])) .nav-collapsed-logo .logo-for-light,
		:global(html:not([style*='color-scheme: light'])) .nav-sidebar-logo .logo-for-light {
			display: none;
		}
	}

	:global(html[style*='color-scheme: dark']) .nav-collapsed-logo .logo-for-dark,
	:global(html[style*='color-scheme: dark']) .nav-sidebar-logo .logo-for-dark {
		display: block;
	}
	:global(html[style*='color-scheme: dark']) .nav-collapsed-logo .logo-for-light,
	:global(html[style*='color-scheme: dark']) .nav-sidebar-logo .logo-for-light {
		display: none;
	}

	/* Mobile collapsed bar — hidden on desktop */
	#nav-collapsed-bar {
		display: none;
	}

	/* Mobile sidebar header — hidden on desktop */
	.nav-sidebar-header {
		display: none;
	}

	/* Mobile topbar section — hidden on desktop */
	.nav-topbar-section {
		display: none;
	}

	.nav-section-divider {
		display: none;
	}

	/* Theme footer — shown on desktop sidebar too */
	.nav-theme-footer {
		margin-block-start: auto;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--navigation-borderColor);
		padding: 0.75rem 0.75rem 0 0.75rem;
	}

	.nav-theme-btn {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		width: 100%;
		padding: 0.45rem 0.45rem;
		border: none;
		border-radius: 0.375rem;
		background: transparent;
		cursor: pointer;
		color: var(--text-primary);
		font-size: 0.975em;
		font-weight: 500;

		:global(svg) {
			width: 1.25em;
			height: 1.25em;
			stroke: currentColor;
			flex-shrink: 0;
		}

		&:hover {
			background-color: var(--background-primary);
			color: var(--accent);
		}
	}

	@media not (max-width: 1024px) {
		/* Use #nav (specificity 1-0-0) to beat the sticky system's
		   [data-scroll-container] [data-sticky-container] [data-sticky] chain (0-3-0),
		   which otherwise keeps position:sticky;top:0 and floats the sidebar over the topbar. */
		#nav {
			position: sticky;
			z-index: auto;
			inset: unset;
			inset-block-start: var(--topbar-height);
			height: calc(100dvh - var(--topbar-height));
			align-self: start;
		}

		li:has(#menu-toggle) {
			display: none;
		}
	}

	@media (max-width: 1024px) {
		nav {
			transition-property: block-size;

			block-size: auto;

			&[popover]:not(:popover-open) {
				block-size: var(--navigation-mobile-blockSize);
				overflow: hidden;
				overscroll-behavior: none;

				#nav-menu {
					display: none;
					interactivity: inert;
					opacity: 0;
					pointer-events: none;
				}
			}

			/* Show collapsed bar only when nav is NOT open */
			&[popover]:not(:popover-open) #nav-collapsed-bar {
				display: flex;
			}

			/* Hide collapsed bar when nav IS open (full sidebar visible) */
			&[popover]:popover-open #nav-collapsed-bar {
				display: none;
			}
		}

		#nav-collapsed-bar {
			position: relative;
			align-items: center;
			justify-content: center;
			height: var(--navigation-mobile-blockSize);
			padding-inline: 1rem;

			.nav-collapsed-logo {
				display: flex;
				align-items: center;
				text-decoration: none;

				img {
					height: 2rem;
				}
			}

			#nav-hamburger {
				position: absolute;
				right: 1rem;
			}
		}

		#nav-hamburger {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.5rem;
			height: 2.5rem;
			border: none;
			background: transparent;
			cursor: pointer;
			padding: 0;
			color: var(--text-primary);

			:global(svg) {
				width: 1.5rem;
				height: 1.5rem;
				stroke: currentColor;
			}
		}

		.nav-sidebar-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.75rem 0.75rem 0.75rem 1.5rem;
			border-block-end: 1px solid var(--navigation-borderColor);
			margin-block-end: 0.75rem;

			.nav-sidebar-logo {
				display: flex;
				align-items: center;
				text-decoration: none;

				img {
					height: 2rem;
				}
			}

			.nav-sidebar-actions {
				display: flex;
				align-items: center;
				gap: 0.25rem;
			}
		}

		#nav-close-btn {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.5rem;
			height: 2.5rem;
			border: none;
			background: transparent;
			cursor: pointer;
			padding: 0;
			color: var(--text-primary);
			flex-shrink: 0;

			:global(svg) {
				width: 1.5rem;
				height: 1.5rem;
				stroke: currentColor;
			}
		}

		.nav-topbar-section {
			display: block;
		}

		.nav-section-divider {
			display: block;
			border: none;
			border-block-start: 1px solid var(--navigation-borderColor);
			margin: 0.75rem 0.75rem;
		}
	}
</style>
