---
import { allRatedWalletsBySlug } from '@/data/wallets'
import WalletStaticPage from '@/views/WalletStaticPage.astro'
export const prerender = true
export const getStaticPaths = () =>
	Object.values(allRatedWalletsBySlug).map(wallet => ({
		params: { walletName: wallet.metadata.id },
		props: { walletName: wallet.metadata.id },
	}))
---

<WalletStaticPage {...Astro.props} />
