---
// Types/constants
import { allRatedWalletsBySlug, allWallets, isValidWalletSlug } from '@/data/wallets'
import { allHardwareModels } from '@/data/hardware-wallets'
import { getNewsForWallet } from '@/data/news'
import type { Variant } from '@/schema/variants'
import type { ResolvedWallet } from '@/schema/wallet'
import { nonEmptyValues } from '@/types/utils/non-empty'
import { supportedHardwareWalletTypes } from '@/utils/supported-hardware-wallets'
import { walletPageData } from '@/views/wallet-page-data'
import { defaultNavigationItems } from '@/constants/navigation'
import { codeSnippetsForReferences } from '@/utils/code-snippet-store'
import { getWalletIcon, walletOgImage } from '@/utils/wallet-og-image'

import { refs, toFullyQualified } from '@/schema/reference'
import { referenceImageDimensions } from '@/utils/reference-image-metadata'

// Routes
export const prerender = true

export const getStaticPaths = () =>
	Object.values(allRatedWalletsBySlug).map(wallet => ({
		params: { walletName: wallet.metadata.id },
	}))

const { walletName } = Astro.params

if (walletName === undefined || !isValidWalletSlug(walletName)) {
	throw new Error(`invalid wallet slug "${walletName}"`)
}

// Data
const wallet = allRatedWalletsBySlug[walletName]
const walletNews = getNewsForWallet(wallet.metadata.id)
const evaluations = [
	wallet.overall,
	...nonEmptyValues<Variant, ResolvedWallet<string>>(wallet.variants).map(
		variant => variant.attributes,
	),
].flatMap(tree => Object.values(tree).flatMap(group => Object.values(group)))
const supportedBrands = new Set<string>(
	evaluations.flatMap(({ evaluation: { outcome } }) =>
		supportedHardwareWalletTypes('metadata' in outcome ? outcome.metadata : null),
	),
)
const hardwareModels = allHardwareModels.filter(
	model => model.brandId === wallet.metadata.id || supportedBrands.has(model.brandId.toUpperCase()),
)
const walletIcon = await getWalletIcon(wallet.metadata)
const walletEntry = Object.entries(allWallets).find(([, data]) => data.metadata.id === walletName)

if (walletEntry === undefined) {
	throw new Error(`no wallet data for slug "${walletName}"`)
}

const [, walletData] = walletEntry
const data = walletPageData(wallet, walletData)
const pageReferences = [
	...evaluations.flatMap(({ evaluation }) => toFullyQualified(evaluation.references)),
	...walletNews.flatMap(refs),
]
const codeSnippets = codeSnippetsForReferences(wallet.metadata.id, pageReferences)
const imageDimensions = await referenceImageDimensions(pageReferences)
// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import WalletPageContext from '@/views/WalletPageContext.svelte'
---

<Layout
	metadata={{
		title: `${wallet.metadata.displayName} - Walletbeat`,
		description: `How does ${wallet.metadata.displayName} stack up as an Ethereum wallet?`,
		icons: [
			{
				url: `/images/wallets/${wallet.metadata.id}.${wallet.metadata.iconExtension}`,
			},
		],
		keywordsBefore: [
			wallet.metadata.id,
			wallet.metadata.displayName,
			`${wallet.metadata.id} wallet`,
			`${wallet.metadata.displayName} wallet`,
			'wallet',
		],
		keywordsAfter: ['ranking', 'reviews', 'security', 'privacy'],
		image: walletOgImage(wallet),
	}}
	preloadComplexIcons
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible'>
		<WalletPageContext
			{walletIcon}
			{data}
			{hardwareModels}
			{walletNews}
			codeSnippets={codeSnippets}
			{imageDimensions}
			client:idle
		/>
	</main>
</Layout>
