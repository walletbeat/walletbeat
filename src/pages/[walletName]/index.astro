---
// Types/constants
import { allRatedWallets, assertValidWalletName } from '@/data/wallets'
import { defaultNavigationItems } from '@/constants/navigation'
import { softwareLadders } from '@/schema/ladders'
import { WalletType } from '@/schema/wallet-types'
import { softwareWalletAttributeTree } from '@/data/software-wallets'
import { hardwareWalletAttributeTree } from '@/data/hardware-wallets'
import { embeddedWalletAttributeTree } from '@/data/embedded-wallets'

// Functions
import { nonEmptyKeys, nonEmptyMap } from '@/types/utils/non-empty.ts'

// Routes
export const prerender = true

export const getStaticPaths = () => [
	...nonEmptyMap(nonEmptyKeys(allRatedWallets), walletName => ({
		params: { walletName },
	})),
]

const { walletName } = Astro.params

assertValidWalletName(walletName)

// Data
const wallet = allRatedWallets[walletName]

const attributeTree = wallet.types[WalletType.SOFTWARE]
	? softwareWalletAttributeTree
	: wallet.types[WalletType.HARDWARE]
		? hardwareWalletAttributeTree
		: wallet.types[WalletType.EMBEDDED]
			? embeddedWalletAttributeTree
			: (() => {
					throw new Error('Invalid wallet type')
				})()

// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import WalletPage from '@/views/WalletPage.svelte'
---

<Layout
	metadata={{
		title: `${wallet.metadata.displayName} - Walletbeat`,
		description: `How does ${wallet.metadata.displayName} stack up as an Ethereum wallet?`,
		icons: [
			{
				url: `/images/wallets/${wallet.metadata.id}.${wallet.metadata.iconExtension}`,
			},
		],
		keywordsBefore: [
			wallet.metadata.id,
			wallet.metadata.displayName,
			`${wallet.metadata.id} wallet`,
			`${wallet.metadata.displayName} wallet`,
			'wallet',
		],
		keywordsAfter: ['ranking', 'reviews', 'security', 'privacy'],
	}}
>
	<Navigation navigationItems={defaultNavigationItems} />

	<main data-sticky-container>
		<WalletPage {wallet} ladders={softwareLadders} attributeTree={attributeTree} client:load />
	</main>
</Layout>
