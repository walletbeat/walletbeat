---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'

// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import EmbeddedWalletTable from '@/views/EmbeddedWalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat',
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container>
		<EmbeddedWalletTable client:visible title='Embedded Wallets' />
	</main>
</Layout>
