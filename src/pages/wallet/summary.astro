---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'
import { displayRatedSoftwareWallets } from '@/data/wallets'
import { softwareWalletAttributeTree } from '@/data/software-wallets'
import { allWalletLadders } from '@/schema/ladders'

// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import WalletTable from '@/views/WalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat',
	}}
>
	<Navigation navigationItems={defaultNavigationItems} />

	<main data-sticky-container>
		<WalletTable
			client:load
			title='Software Wallets'
			ladders={allWalletLadders}
			wallets={Object.values(displayRatedSoftwareWallets)}
			attributeTree={softwareWalletAttributeTree}
		/>
	</main>
</Layout>
