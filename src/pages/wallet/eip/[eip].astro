---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'
import { repositoryUrl } from '@/constants'
import { eips } from '@/data/eips'
import { ratedEmbeddedWallets } from '@/data/embedded-wallets'
import { ratedHardwareWallets } from '@/data/hardware-wallets'
import { ratedSoftwareWallets } from '@/data/software-wallets'
import {
	EipSupportStatus,
	ratedWalletEipSupportByStatus,
	type EipStatusSupportCard,
} from '@/schema/eip-support'
import { type Eip, eipShortLabel } from '@/schema/eips'
import type { RatedWallet } from '@/schema/wallet'
import { getWalletUrl } from '@/utils/urls'

// Components
import Layout from '@/layouts/Layout.astro'
import EipDetails from '@/views/EipDetails.svelte'
import EipStatusSupportCards from '@/views/EipStatusSupportCards.svelte'
import Navigation from '@/views/Navigation.astro'
import GitHubIcon from 'lucide-static/icons/github.svg?raw'

export const prerender = true

export const getStaticPaths = () =>
	Object.values(eips)
		// EIP-7702 has its own richer tracker page at /wallet/7702/.
		.filter(eip => eip.number !== '7702')
		.map(eip => ({ params: { eip: eip.number }, props: { eip } }))

type Props = { eip: Eip }

const { eip } = Astro.props

/** Precompute the per-status EIP support cards at build time. */
function eipStatusSupportCards(wallets: Array<RatedWallet<string>>): EipStatusSupportCard[] {
	return wallets.flatMap(wallet => {
		const byStatus = ratedWalletEipSupportByStatus(wallet, eip.number)

		return Object.values(EipSupportStatus).flatMap(status => {
			const entry = byStatus[status]

			return entry === undefined
				? []
				: [
						{
							id: wallet.metadata.id,
							displayName: wallet.metadata.displayName,
							iconExtension: wallet.metadata.iconExtension,
							url: getWalletUrl(wallet),
							status,
							variants: entry.variants,
							references: entry.references,
						},
					]
		})
	})
}

const softwareCards = eipStatusSupportCards(Object.values(ratedSoftwareWallets))
const hardwareCards = eipStatusSupportCards(Object.values(ratedHardwareWallets))
const embeddedCards = eipStatusSupportCards(Object.values(ratedEmbeddedWallets))
---

<Layout
	metadata={{
		title: `Walletbeat - ${eipShortLabel(eip)} wallet adoption`,
		description: `Which wallets implement ${eipShortLabel(eip)} (${eip.friendlyName})? Track the adoption of ${eipShortLabel(eip)} across the Ethereum wallet ecosystem.`,
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-8'>
		<header data-scroll-item='inline-detached padding-match-start'>
			<EipDetails eip={eip} />
		</header>

		{
			softwareCards.length > 0 && (
				<EipStatusSupportCards
					title={`Software Wallets by ${eipShortLabel(eip)} Support`}
					cards={softwareCards}
					client:visible
				/>
			)
		}

		{
			hardwareCards.length > 0 && (
				<EipStatusSupportCards
					title={`Hardware Wallets by ${eipShortLabel(eip)} Support`}
					cards={hardwareCards}
					client:visible
				/>
			)
		}

		{
			embeddedCards.length > 0 && (
				<EipStatusSupportCards
					title={`Embedded Wallets by ${eipShortLabel(eip)} Support`}
					cards={embeddedCards}
					client:visible
				/>
			)
		}

		<footer data-scroll-item='inline-detached padding-match-end' data-row='center'>
			<p>
				Incorrect data? Submit a PR: <a
					href={repositoryUrl}
					target='_blank'
					rel='noopener noreferrer'
					data-input
					data-link='camouflaged'><span data-icon set:html={GitHubIcon} />GitHub Repository</a
				>
			</p>
		</footer>
	</main>
</Layout>

<style>
	main {
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 60.5rem;
			--scrollItem-inlineDetached-paddingStart: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
			--scrollItem-inlineDetached-maxPaddingMatchStart: 5rem;
			--scrollItem-inlineDetached-paddingEnd: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
			--scrollItem-inlineDetached-maxPaddingMatchEnd: 5rem;
		}
	}

	header {
		font-size: 1.05rem;
	}

	footer {
		p {
			color: var(--text-secondary);
			font-size: 0.9rem;
		}
	}
</style>
