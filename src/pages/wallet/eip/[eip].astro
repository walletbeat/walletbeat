---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'
import { repositoryUrl } from '@/constants'
import { eips } from '@/data/eips'
import { embeddedWalletAttributeTree, ratedEmbeddedWallets } from '@/data/embedded-wallets'
import { hardwareWalletAttributeTree, ratedHardwareWallets } from '@/data/hardware-wallets'
import { ratedSoftwareWallets, softwareWalletAttributeTree } from '@/data/software-wallets'
import type { AttributeTree } from '@/schema/attribute-groups'
import {
	EipSupportStatus,
	ratedWalletEipSupportByStatus,
	type EipStatusSupportCard,
} from '@/schema/eip-support'
import { type Eip, eipShortLabel } from '@/schema/eips'
import type { RatedWallet } from '@/schema/wallet'
import { type CodeSnippetIndex } from '@/utils/code-snippet-index'
import { codeSnippetsForReferences } from '@/utils/code-snippet-store'
import { sortEipSupportCards } from '@/utils/eip-support-sort'
import { getWalletUrl } from '@/utils/urls'

// Components
import Layout from '@/layouts/Layout.astro'
import EipDetails from '@/views/EipDetails.svelte'
import EipSupportPie from '@/views/EipSupportPie.svelte'
import EipStatusSupportCards from '@/views/EipStatusSupportCards.svelte'
import Navigation from '@/views/Navigation.astro'
import GitHubIcon from 'lucide-static/icons/github.svg?raw'

export const prerender = true

export const getStaticPaths = () =>
	Object.values(eips)
		// EIP-7702 has its own richer tracker page at /wallet/7702/.
		.filter(eip => eip.number !== '7702')
		.map(eip => ({ params: { eip: eip.number }, props: { eip } }))

type Props = { eip: Eip }

const { eip } = Astro.props

/**
 * Precompute the per-status EIP support cards at build time, ordered by
 * earliest evidence of support and then by the homepage order.
 */
function eipStatusSupportCards<_AttributeGroupId extends string>(
	attributeTree: AttributeTree<_AttributeGroupId>,
	wallets: Array<RatedWallet<_AttributeGroupId>>,
): EipStatusSupportCard[] {
	const entries = wallets.flatMap(wallet => {
		const byStatus = ratedWalletEipSupportByStatus(wallet, eip.number)

		return Object.values(EipSupportStatus).flatMap(status => {
			const entry = byStatus[status]

			return entry === undefined
				? []
				: [
						{
							wallet,
							card: {
								id: wallet.metadata.id,
								displayName: wallet.metadata.displayName,
								iconExtension: wallet.metadata.iconExtension,
								url: getWalletUrl(wallet),
								status,
								variants: entry.variants,
								references: entry.references,
							},
						},
					]
		})
	})

	return sortEipSupportCards(attributeTree, entries)
}

/** The stored code snippets referenced by `cards`. */
function cardCodeSnippets(cards: EipStatusSupportCard[]): CodeSnippetIndex {
	return Object.fromEntries(
		cards.flatMap(card => Object.entries(codeSnippetsForReferences(card.id, card.references))),
	)
}

const softwareCards = eipStatusSupportCards(
	softwareWalletAttributeTree,
	Object.values(ratedSoftwareWallets),
)
const hardwareCards = eipStatusSupportCards(
	hardwareWalletAttributeTree,
	Object.values(ratedHardwareWallets),
)
const embeddedCards = eipStatusSupportCards(
	embeddedWalletAttributeTree,
	Object.values(ratedEmbeddedWallets),
)
---

<Layout
	metadata={{
		title: `Walletbeat - ${eipShortLabel(eip)} wallet adoption`,
		description: `Which wallets implement ${eipShortLabel(eip)} (${eip.friendlyName})? Track the adoption of ${eipShortLabel(eip)} across the Ethereum wallet ecosystem.`,
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-8'>
		<header data-scroll-item='inline-detached padding-match-start' data-row='start wrap gap-8'>
			<div data-row-item='flexible basis-4'>
				<EipDetails eip={eip} headingLevel={1} />
			</div>

			{
				softwareCards.length > 0 && (
					<EipSupportPie
						cards={softwareCards}
						listId='software-wallets'
						walletTypeLabel='software wallets'
						eipLabel={eipShortLabel(eip)}
					/>
				)
			}
		</header>

		{
			softwareCards.length > 0 && (
				<EipStatusSupportCards
					id='software-wallets'
					title={`Software Wallets by ${eipShortLabel(eip)} Support`}
					cards={softwareCards}
					codeSnippets={cardCodeSnippets(softwareCards)}
					client:visible
				/>
			)
		}

		{
			hardwareCards.length > 0 && (
				<EipStatusSupportCards
					title={`Hardware Wallets by ${eipShortLabel(eip)} Support`}
					cards={hardwareCards}
					codeSnippets={cardCodeSnippets(hardwareCards)}
					client:visible
				/>
			)
		}

		{
			embeddedCards.length > 0 && (
				<EipStatusSupportCards
					title={`Embedded Wallets by ${eipShortLabel(eip)} Support`}
					cards={embeddedCards}
					codeSnippets={cardCodeSnippets(embeddedCards)}
					client:visible
				/>
			)
		}

		<footer data-scroll-item='inline-detached padding-match-end' data-row='center'>
			<p>
				Incorrect data? Submit a PR: <a
					href={repositoryUrl}
					target='_blank'
					rel='noopener noreferrer'
					data-input
					data-link='camouflaged'><span data-icon set:html={GitHubIcon} />GitHub Repository</a
				>
			</p>
		</footer>
	</main>
</Layout>

<script>
	import { eipFinalForLabel } from '@/schema/eips'
	import { assertCalendarDate, daysSince } from '@/types/date'

	// Recompute "Final for N days" in the browser, so it is current between builds.
	for (const element of document.querySelectorAll<HTMLElement>('[data-final-since]')) {
		const finalizedDate = element.dataset.finalSince

		if (finalizedDate !== undefined) {
			element.textContent = eipFinalForLabel(daysSince(assertCalendarDate(finalizedDate)))
		}
	}
</script>

<style>
	main {
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 60.5rem;
			--scrollItem-inlineDetached-paddingStart: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
			--scrollItem-inlineDetached-maxPaddingMatchStart: 5rem;
			--scrollItem-inlineDetached-paddingEnd: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
			--scrollItem-inlineDetached-maxPaddingMatchEnd: 5rem;
		}
	}

	header {
		font-size: 1.05rem;
	}

	footer {
		p {
			color: var(--text-secondary);
			font-size: 0.9rem;
		}
	}
</style>
