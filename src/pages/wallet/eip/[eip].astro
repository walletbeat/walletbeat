---
import { eipOgImage } from '@/utils/eip-og-image'
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'
import { repositoryUrl } from '@/constants'
import { eips } from '@/data/eips'
import { ratedEmbeddedWallets } from '@/data/embedded-wallets'
import { ratedHardwareWallets } from '@/data/hardware-wallets'
import { ratedSoftwareWallets } from '@/data/software-wallets'
import type { EipStatusSupportCard } from '@/schema/eip-support'
import { type Eip, eipShortLabel } from '@/schema/eips'
import { type CodeSnippetIndex } from '@/utils/code-snippet-index'
import { codeSnippetsForReferences } from '@/utils/code-snippet-store'
import { eipStatusSupportCards } from '@/utils/eip-support-cards'
import { childHeadingLevel } from '@/types/heading'

// Components
import Layout from '@/layouts/Layout.astro'
import EipDetails from '@/views/EipDetails.svelte'
import Timestamp from '@/components/Timestamp.svelte'
import EipSupportPie from '@/views/EipSupportPie.svelte'
import EipStatusSupportCards from '@/views/EipStatusSupportCards.svelte'
import Navigation from '@/views/Navigation.astro'
import GitHubIcon from 'lucide-static/icons/github.svg?raw'

export const prerender = true

export const getStaticPaths = () =>
	Object.values(eips)
		// EIP-7702 has its own richer tracker page at /wallet/7702/.
		.filter(eip => eip.number !== '7702')
		.map(eip => ({ params: { eip: eip.number }, props: { eip } }))

type Props = { eip: Eip }

const { eip }: Props = Astro.props

/** The stored code snippets referenced by `cards`. */
function cardCodeSnippets(cards: EipStatusSupportCard[]): CodeSnippetIndex {
	return Object.fromEntries(
		cards.flatMap(card => Object.entries(codeSnippetsForReferences(card.id, card.references))),
	)
}

const pageHeadingLevel = 1 as const
const supportHeadingLevel = childHeadingLevel[pageHeadingLevel]

const softwareCards = eipStatusSupportCards(eip.number, Object.values(ratedSoftwareWallets))
const hardwareCards = eipStatusSupportCards(eip.number, Object.values(ratedHardwareWallets))
const embeddedCards = eipStatusSupportCards(eip.number, Object.values(ratedEmbeddedWallets))
---

<Layout
	metadata={{
		image: eipOgImage(eip),
		title: `Walletbeat - ${eipShortLabel(eip)} wallet adoption`,
		description: `Which wallets implement ${eipShortLabel(eip)} (${eip.friendlyName})? Track the adoption of ${eipShortLabel(eip)} across the Ethereum wallet ecosystem.`,
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-8'>
		<header data-scroll-item='inline-detached padding-match-start' data-row='start wrap gap-8'>
			<div data-row-item='flexible basis-4'>
				<EipDetails eip={eip} headingLevel={pageHeadingLevel}>
					<Fragment slot='timestamp'>
						{eip.finalizedDate !== null && <Timestamp date={eip.finalizedDate} client:visible />}
					</Fragment>
				</EipDetails>
			</div>

			{
				softwareCards.length > 0 && (
					<EipSupportPie
						cards={softwareCards}
						listId='software-wallets'
						walletTypeLabel='software wallets'
						eipLabel={eipShortLabel(eip)}
					/>
				)
			}
		</header>

		{
			softwareCards.length > 0 && (
				<EipStatusSupportCards
					headingLevel={supportHeadingLevel}
					id='software-wallets'
					title={`Software Wallets by ${eipShortLabel(eip)} Support`}
					cards={softwareCards}
					codeSnippets={cardCodeSnippets(softwareCards)}
					client:visible
				/>
			)
		}

		{
			hardwareCards.length > 0 && (
				<EipStatusSupportCards
					headingLevel={supportHeadingLevel}
					title={`Hardware Wallets by ${eipShortLabel(eip)} Support`}
					cards={hardwareCards}
					codeSnippets={cardCodeSnippets(hardwareCards)}
					client:visible
				/>
			)
		}

		{
			embeddedCards.length > 0 && (
				<EipStatusSupportCards
					headingLevel={supportHeadingLevel}
					title={`Embedded Wallets by ${eipShortLabel(eip)} Support`}
					cards={embeddedCards}
					codeSnippets={cardCodeSnippets(embeddedCards)}
					client:visible
				/>
			)
		}

		<footer data-scroll-item='inline-detached padding-match-end' data-row='center'>
			<p>
				Incorrect data? Submit a PR: <a
					href={repositoryUrl}
					target='_blank'
					rel='noopener noreferrer'
					data-input
					data-link='camouflaged'><span data-icon set:html={GitHubIcon} />GitHub Repository</a
				>
			</p>
		</footer>
	</main>
</Layout>

<style>
	main {
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 60.5rem;
			--scrollItem-inlineDetached-paddingStart: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
			--scrollItem-inlineDetached-maxPaddingMatchStart: 5rem;
			--scrollItem-inlineDetached-paddingEnd: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
			--scrollItem-inlineDetached-maxPaddingMatchEnd: 5rem;
		}
	}

	header {
		font-size: 1.05rem;
	}

	footer {
		p {
			color: var(--text-secondary);
			font-size: 0.9rem;
		}
	}
</style>
