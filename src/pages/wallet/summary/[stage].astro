---
import type { InferGetStaticPropsType } from 'astro'
import SoftwareWalletSummaryPage from '@/views/SoftwareWalletSummaryPage.astro'
import { stageQualificationChoices } from '@/views/wallet-table-stage'

export function getStaticPaths() {
	return stageQualificationChoices
		.filter(choice => choice.path !== '')
		.map(choice => ({
			params: { stage: choice.path },
			props: { initialStageSelection: choice.id },
		}))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { initialStageSelection } = Astro.props
---

<SoftwareWalletSummaryPage {initialStageSelection} />
