---
import { defaultNavigationItems } from '@/constants/navigation'
import Layout from '@/layouts/Layout.astro'
import { finderWalletData } from '@/utils/wallet-finder-data'
import Navigation from '@/views/Navigation.astro'
import WalletFinder from '@/views/WalletFinder.svelte'

const wallets = finderWalletData()
---

<Layout
	metadata={{
		title: 'Find a wallet - Walletbeat',
		description: 'Find software wallets that match your platform, requirements, and preferences.',
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />
	<main data-column-item='flexible' data-sticky-container data-column='gap-6'>
		<header data-scroll-item='inline-detached padding-match-start' data-column='gap-3'>
			<h1>Find a wallet</h1>
			<p>Choose what matters to you and explore software wallets that match your requirements.</p>
			<p>Your answers stay in this page and are cleared when you reload it.</p>
			<a href='/wallet/summary/'>Browse all software wallets</a>
		</header>
		<div data-scroll-item='inline-detached padding-match-start' data-column='gap-6'>
			<noscript
				><p>
					Enable JavaScript to use the questionnaire, or browse the software wallet comparison.
				</p></noscript
			>
			<WalletFinder {wallets} client:load />
		</div>
	</main>
</Layout>
