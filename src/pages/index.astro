---
// Constants
import { defaultNavigationItems } from '@/constants/navigation'
import { softwareLadders } from '@/schema/ladders'
import { ratedSoftwareWallets, softwareWalletAttributeTree } from '@/data/software-wallets'
import { ratedHardwareWallets, hardwareWalletAttributeTree } from '@/data/hardware-wallets'

// Layouts
import Layout from '../layouts/Layout.astro'

// Components
import Navigation from '@/views/Navigation.astro'
import WalletTable from '@/views/WalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat',
	}}
>
	<Navigation navigationItems={defaultNavigationItems} />

	<main data-sticky-container data-column='gap-6'>
		<header data-sticky='inline'>
			<h1>Who watches the wallets?</h1>

			<p>
				This website is still in beta. It aims to provide a comprehensive list of wallets, their
				functionality, practices, and support for certain standards.
			</p>
			<p>
				We welcome contributions via the <a
					href='https://github.com/walletbeat/walletbeat'
					target='_blank'
					rel='noreferrer'>GitHub Repository</a
				>.
			</p>
			<p>
				<a
					href='https://github.com/walletbeat/walletbeat/blob/beta/CONTRIBUTING.md'
					target='_blank'
				>
					Learn More.
				</a>
			</p>
		</header>

		<WalletTable
			client:visible
			title='Software Wallets'
			ladders={softwareLadders}
			wallets={Object.values(ratedSoftwareWallets)}
			attributeTree={softwareWalletAttributeTree}
		/>

		<WalletTable
			client:visible
			title='Hardware Wallets'
			wallets={Object.values(ratedHardwareWallets)}
			attributeTree={hardwareWalletAttributeTree}
		/>
	</main>
</Layout>

<style>
	@font-face {
		font-family: 'SP Monorium';
		src:
			url('/fonts/sp-monorium-regular.woff2') format('woff2'),
			url('/fonts/sp-monorium-regular.woff') format('woff');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	main {
		> header {
			&::before {
				content: '';
			}

			padding: clamp(0.75rem, 0.04 * var(--scrollContainer-sizeInline), 4rem)
				clamp(1.5rem, 0.04 * var(--scrollContainer-sizeInline), 3rem);

			text-shadow:
				0 0 1em var(--background-primary),
				0 0 2em var(--background-primary),
				0 0 3em var(--background-primary);

			h1 {
				font-family: 'SP Monorium', monospace;
				font-size: clamp(1.75em, 0.04 * var(--scrollContainer-sizeInline), 3.5em);
				font-weight: 800;
				margin: 0 0 1rem 0;
				color: var(--text-primary);
				line-height: 1.1;
			}

			p {
				font-size: smaller;
				line-height: 1.6;
				margin: 0;
				text-wrap: balance;
				max-width: 420px;
				margin-bottom: 1em;
				color: var(--text-secondary);
			}
		}
	}
</style>
