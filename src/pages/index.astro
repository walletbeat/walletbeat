---
// Constants
import { defaultNavigationItems } from '@/constants/navigation'
import { ratedHardwareWallets } from '@/data/hardware-wallets'
import { ratedSoftwareWallets } from '@/data/software-wallets'

import { attributeTree } from '@/schema/attribute-groups'

const attributeGroups = Object.values(attributeTree)

// Layouts
import Layout from '../layouts/Layout.astro'

// Components
import Navigation from '@/views/Navigation.astro'
import WalletTable from '@/views/WalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat',
	}}
>
	<Navigation navigationItems={defaultNavigationItems} />

	<main data-sticky-container data-column='gap-6'>
		<header data-sticky='inline'>
			<h1>Who watches the wallets?</h1>

			<p>
				This website is still in beta. It aims to provide a comprehensive list of wallets, their
				functionality, practices, and support for certain standards.
			</p>

			<p>
				We welcome contributions via the <a
					href='https://github.com/walletbeat/walletbeat'
					target='_blank'
					rel='noreferrer'>GitHub Repository</a
				>.
			</p>
		</header>

		<WalletTable
			client:visible
			title='Software Wallets'
			wallets={Object.values(ratedSoftwareWallets)}
			{attributeGroups}
		/>

		<WalletTable
			client:visible
			title='Hardware Wallets'
			wallets={Object.values(ratedHardwareWallets)}
			{attributeGroups}
		/>
	</main>
</Layout>

<style>
	@font-face {
		font-family: 'SP Monorium';
		src:
			url('/fonts/sp-monorium-regular.woff2') format('woff2'),
			url('/fonts/sp-monorium-regular.woff') format('woff');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	main {
		> header {
			&::before {
				content: '';

				background: url('./robot.png') 98% 1rem / clamp(12rem, 24cqi, 20rem) no-repeat;
			}

			padding: clamp(1.5rem, 0.08 * var(--scrollContainer-sizeInline), 8rem)
				clamp(1.5rem, 0.04 * var(--scrollContainer-sizeInline), 3rem);

			text-shadow:
				0 0 1em var(--background-primary),
				0 0 2em var(--background-primary),
				0 0 3em var(--background-primary);

			h1 {
				font-family: 'SP Monorium', 'Space Grotesk', sans-serif;
				font-size: clamp(2rem, 5vw, 60px);
				font-weight: 400;
				color: var(--accent);
				margin: 0 0 1rem 0;
				line-height: 1.1;
			}

			p {
				font-size: smaller;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0;
				text-wrap: balance;
				max-width: 72.5%;
			}
		}
	}
</style>
