---
// Constants
import { defaultNavigationItems } from '@/constants/navigation'

// Layouts
import Layout from '../layouts/Layout.astro'

// Components
import Navigation from '@/views/Navigation.astro'
import SoftwareWalletTable from '@/views/SoftwareWalletTable.svelte'
import HardwareWalletTable from '@/views/HardwareWalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat - Who watches the wallets?',
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-6'>
		<header
			class='home-hero'
			data-scroll-item='inline-detached padding-match-start padding-match-end'
		>
			<h1>Who watches the wallets?</h1>

			<p>
				This website is still in beta. It aims to provide a comprehensive list of wallets, their
				functionality, practices, and support for certain standards.
			</p>
			<p>
				We welcome contributions via the <a
					href='https://github.com/walletbeat/walletbeat'
					target='_blank'
					rel='noreferrer'>GitHub Repository</a
				>.
			</p>
			<p>
				<a
					href='https://github.com/walletbeat/walletbeat/blob/beta/CONTRIBUTING.md'
					target='_blank'
				>
					Learn More.
				</a>
			</p>
		</header>

		<SoftwareWalletTable client:visible title='Software Wallets' />

		<HardwareWalletTable client:visible title='Hardware Wallets' />
	</main>
</Layout>

<style>
	main {
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 60.5rem;
			--scrollItem-inlineDetached-paddingStart: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
			--scrollItem-inlineDetached-maxPaddingMatchStart: 4rem;
			--scrollItem-inlineDetached-paddingEnd: clamp(
				1.5rem,
				0.04 * var(--scrollContainer-sizeInline),
				3rem
			);
		}

		> header {
			--homeHero-backgroundColor: light-dark(#f8e6ff, #3f165e);
			--homeHero-glowColor: light-dark(#f0c6ff, var(--homeHero-backgroundColor));
			--homeHero-highlightColor: light-dark(#d62f88, #ff4fb8);
			--homeHero-rimColor: light-dark(#ffffff, #f8edff);
			--homeHero-textColor: light-dark(#2d123d, #f5f2f7);
			--homeHero-textSecondaryColor: color-mix(
				in oklch,
				var(--homeHero-textColor) 78%,
				transparent
			);

			overflow: clip;
			padding-block-end: clamp(1.5rem, 0.08 * var(--scrollContainer-sizeInline), 8rem);
			text-shadow:
				0 0 1em var(--homeHero-glowColor),
				0 0 2em var(--homeHero-glowColor),
				0 0 3em var(--homeHero-glowColor);

			&::before {
				content: '';

				background:
					linear-gradient(
						to right,
						color-mix(in oklch, var(--homeHero-backgroundColor) 100%, transparent) 34cqi,
						color-mix(in oklch, var(--homeHero-backgroundColor) 80%, transparent) 72cqi,
						color-mix(in oklch, var(--homeHero-backgroundColor) 34%, transparent)
					),
					radial-gradient(
						circle at 90% 12%,
						color-mix(in oklch, var(--homeHero-rimColor) 34%, transparent) 0,
						transparent 21cqi
					),
					radial-gradient(
						circle at 82% 88%,
						color-mix(in oklch, var(--homeHero-highlightColor) 24%, transparent) 0,
						transparent 26cqi
					),
					var(--homeHero-backgroundColor);
			}

			> * {
				position: relative;
				z-index: 1;
			}

			h1 {
				font-family: var(--fontFamily-spMonorium);
				font-size: clamp(1.75em, 0.04 * var(--scrollContainer-sizeInline), 3.5em);
				font-weight: 800;
				margin: 0 0 1rem 0;
				color: var(--homeHero-textColor);
				line-height: 1.1;
			}

			p {
				font-size: smaller;
				line-height: 1.6;
				margin: 0;
				text-wrap: balance;
				max-width: 72.5%;
				margin-bottom: 1em;
				color: var(--homeHero-textSecondaryColor);
			}

			a {
				color: currentColor;
			}
		}
	}
</style>
