---
import BookOpenIcon from 'lucide-static/icons/book-open.svg?raw'
import GitHubIcon from 'lucide-static/icons/github.svg?raw'

// Constants
import { defaultNavigationItems } from '@/constants/navigation'
import { GITHUB_REPO_URL, githubBlobUrl } from '@/constants/github'

// Layouts
import Layout from '../layouts/Layout.astro'

// Components
import Navigation from '@/views/Navigation.astro'
import SoftwareWalletTable from '@/views/SoftwareWalletTable.svelte'

const heading = 'Who watches the wallets?'
---

<Layout
	preloadSpMonorium
	splashHeading={heading}
	metadata={{
		title: `Walletbeat - ${heading}`,
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-6'>
		<header
			data-scroll-item='inline-detached padding-match-start padding-match-end'
			data-column='gap-4'
		>
			<div class='hero-background' aria-hidden='true'>
				<img src='/logo.svg' alt='' width='516' height='126' data-safari='invert-lightness' />
			</div>

			<h1>{heading}</h1>

			<p>
				Walletbeat aims to provide a comprehensive list of wallets, their functionality, practices,
				and support for certain standards. We welcome contributions.
			</p>

			<nav aria-label='Contribute' data-row='start gap-3 wrap'>
				<a data-input href={GITHUB_REPO_URL} target='_blank' rel='noreferrer'>
					<span aria-hidden='true' set:html={GitHubIcon} />
					GitHub repository
				</a>
				<a data-input href={githubBlobUrl('/CONTRIBUTING.md')} target='_blank' rel='noreferrer'>
					<span aria-hidden='true' set:html={BookOpenIcon} />
					How to contribute
				</a>
			</nav>
		</header>

		<SoftwareWalletTable client:visible title='Software Wallets' />
	</main>
</Layout>

<style>
	:global(#content),
	main[data-sticky-container] {
		--scrollItem-inlineDetached-maxSize: 60.5rem;
		--scrollItem-inlineDetached-paddingStart: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
		--scrollItem-inlineDetached-maxPaddingMatchStart: 4rem;
		--scrollItem-inlineDetached-paddingEnd: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
	}

	main {
		padding-block-end: 3rem;

		> header {
			container-type: inline-size;
			font-size: 16px;
			.hero-background {
				position: absolute;
				inset: 0;
				inset-block-end: clamp(-6rem, -9cqi, -3rem);
				pointer-events: none;
				mask-image: linear-gradient(to bottom, black calc(100% - 6rem), transparent);
				background: var(---hero-background);

				img {
					--mark-inline-size: clamp(10em, 7.5em + 23cqi, 28em);

					position: absolute;
					/* Keep the mark in the fade when wrapping controls make the hero taller. */
					inset-block-start: max(2em, 8em - 13cqi, 100% - var(--mark-inline-size) * 7 / 6 - 0.5rem);
					inset-inline-end: 2cqi;
					inline-size: var(--mark-inline-size);
					block-size: auto;
					aspect-ratio: 6 / 7;
					object-fit: cover;
					object-position: left;
					opacity: 0.08;
					mask-image: linear-gradient(to right, transparent, black 45%);
				}
			}

			> :not(.hero-background) {
				position: relative;
			}

			:global(html[data-splash="moving"]) & > :is(h1, p, nav) {
				visibility: hidden;
			}

			h1 {
				font-size: clamp(1.75em, 0.04 * var(--scrollContainer-sizeInline), 3.5em);
				font-family: var(--fontFamily-spMonorium);
				font-weight: 400;
				line-height: 1.1;
			}

			p {
				line-height: 1.6;
				text-wrap: pretty;
				max-inline-size: 36rem;
			}

			a {
				&[data-input] {
					font-size: inherit;
					min-block-size: 2.75em;
					color: var(--accent-color);
					background-color: var(--accent-backgroundColor);
					border-color: currentColor;

					> span {
						display: inline-flex;
					}

					:global(svg) {
						inline-size: 1em;
						block-size: 1em;
					}
				}
			}
		}
	}
</style>
