---
// Constants
import { defaultNavigationItems } from '@/constants/navigation'
import { GITHUB_REPO_URL, githubBlobUrl } from '@/constants/github'

// Layouts
import Layout from '../layouts/Layout.astro'

// Components
import { Font } from 'astro:assets'
import Navigation from '@/views/Navigation.astro'
import SoftwareWalletTable from '@/views/SoftwareWalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat - Who watches the wallets?',
	}}
>
	<Font cssVariable='--fontFamily-spMonorium' preload />
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-6'>
		<header
			data-scroll-item='inline-detached padding-match-start padding-match-end'
			data-column='gap-4'
		>
			<h1>Who watches the wallets?</h1>

			<p>
				This website is still in beta. It aims to provide a comprehensive list of wallets, their
				functionality, practices, and support for certain standards. We welcome contributions.
			</p>

			<nav aria-label='Contribute' data-row='start gap-3 wrap'>
				<a data-input href={GITHUB_REPO_URL} target='_blank' rel='noreferrer'>
					GitHub repository
				</a>
				<a data-input href={githubBlobUrl('/CONTRIBUTING.md')} target='_blank' rel='noreferrer'>
					How to contribute →
				</a>
			</nav>
		</header>

		<SoftwareWalletTable client:load title='Software Wallets' />
	</main>
</Layout>

<style>
	:global(#content),
	main[data-sticky-container] {
		--scrollItem-inlineDetached-maxSize: 60.5rem;
		--scrollItem-inlineDetached-paddingStart: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
		--scrollItem-inlineDetached-maxPaddingMatchStart: 4rem;
		--scrollItem-inlineDetached-paddingEnd: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
	}

	main {
		padding-block-end: 3rem;

		> header {
			font-size: max(1rem, 16px);
			padding-block: clamp(2rem, 0.06 * var(--scrollContainer-sizeInline), 5rem);
			background:
				linear-gradient(to right, var(--background-primary), transparent 150%),
				url('/images/background/ascii-flower-block.svg') right 8% top 12% /
					clamp(8rem, 20cqi, 18rem) auto no-repeat,
				url('/images/background/ascii-symbol-clusters.svg') right -4% bottom -2rem /
					clamp(12rem, 32cqi, 28rem) auto no-repeat,
				url('/images/background/ascii-dot-field.svg') center / 34rem auto repeat,
				light-dark(#f0dafa, #4b1e70);

			h1 {
				font-size: clamp(1.75em, 0.04 * var(--scrollContainer-sizeInline), 3.5em);
				font-family: var(--fontFamily-spMonorium);
				font-weight: 400;
				text-transform: uppercase;
				line-height: 1.1;
				text-shadow:
					0 0 1em var(--accent-backgroundColor),
					0 0 2em var(--accent-backgroundColor);
			}

			p {
				line-height: 1.6;
				text-wrap: pretty;
				max-inline-size: 36rem;
				color: var(--text-secondary);
			}

			a {
				&[data-input] {
					font-size: inherit;
					min-block-size: 2.75em;
				}
			}
		}
	}
</style>
