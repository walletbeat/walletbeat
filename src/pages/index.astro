---
// Constants
import { defaultNavigationItems } from '@/constants/navigation'

// Layouts
import Layout from '../layouts/Layout.astro'

// Components
import Navigation from '@/views/Navigation.astro'
import SoftwareWalletTable from '@/views/SoftwareWalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat - Who watches the wallets?',
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-6'>
		<header
			data-scroll-item='inline-detached padding-match-start padding-match-end'
			data-column='gap-4'
		>
			<h1>Who watches the wallets?</h1>

			<p>
				This website is still in beta. It aims to provide a comprehensive list of wallets, their
				functionality, practices, and support for certain standards. We welcome contributions.
			</p>

			<nav aria-label='Contribute' data-row='start gap-3 wrap'>
				<a
					data-input
					href='https://github.com/walletbeat/walletbeat'
					target='_blank'
					rel='noreferrer'
				>
					GitHub repository
				</a>
				<a
					data-input
					href='https://github.com/walletbeat/walletbeat/blob/beta/CONTRIBUTING.md'
					target='_blank'
					rel='noreferrer'
				>
					How to contribute →
				</a>
			</nav>
		</header>

		<SoftwareWalletTable client:visible title='Software Wallets' />
	</main>
</Layout>

<style>
	:global(#content),
	main[data-sticky-container] {
		--scrollItem-inlineDetached-maxSize: 60.5rem;
		--scrollItem-inlineDetached-paddingStart: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
		--scrollItem-inlineDetached-maxPaddingMatchStart: 4rem;
		--scrollItem-inlineDetached-paddingEnd: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
	}

	main {
		padding-block-end: 3rem;

		> header {
			font-size: max(1rem, 16px);

			h1 {
				font-size: clamp(1.75em, 0.04 * var(--scrollContainer-sizeInline), 3.5em);
				font-weight: 800;
				line-height: 1.1;
				text-shadow:
					0 0 1em var(--accent-backgroundColor),
					0 0 2em var(--accent-backgroundColor);
			}

			p {
				line-height: 1.6;
				text-wrap: pretty;
				max-inline-size: 36rem;
				color: var(--text-secondary);
			}

			a {
				&[data-input] {
					font-size: inherit;
					min-block-size: 2.75em;
				}
			}
		}
	}
</style>
