---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'

// Components
import Layout from '../layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
---

<Layout
	metadata={{
		title: 'Page not found | Walletbeat',
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-4'>
		<h1>404</h1>

		<p>Page not found.</p>

		<p data-scroll-item='padding-match-end'>
			<a href='/'>Home</a>
		</p>
	</main>
</Layout>

<style>
	main {
		align-self: stretch;
		text-align: center;

		h1 {
			font-size: 6em;
		}
	}
</style>
