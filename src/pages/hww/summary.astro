---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'
import { hardwareWalletAttributeTree, ratedHardwareWallets } from '@/data/hardware-wallets'

// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import WalletTable from '@/views/WalletTable.svelte'
import WalletTableData from '@/views/WalletTableData.svelte'
---

<Layout
	metadata={{
		title: 'Ethereum Hardware Wallets - Walletbeat',
	}}
>
	<Navigation navigationItems={defaultNavigationItems} />

	<main data-sticky-container>
		<WalletTableData client:idle title='Hardware Wallets' tableDataId='hww-summary'>
			<WalletTable
				title='Hardware Wallets'
				wallets={Object.values(ratedHardwareWallets)}
				attributeTree={hardwareWalletAttributeTree}
			/>
		</WalletTableData>
	</main>
</Layout>
