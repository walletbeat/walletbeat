---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'

// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import HardwareWalletTable from '@/views/HardwareWalletTable.svelte'

// Content
const intro =
	"Hardware wallets are dedicated devices that keep your private keys off your computer and phone. Each transaction is shown on the device's own screen and only signed once you approve it there. Walletbeat rates every device against the same public criteria; expand a row to see its ratings, or open a wallet for the full evaluation."
---

<Layout
	metadata={{
		title: 'Ethereum Hardware Wallets - Walletbeat',
		description: intro,
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-6'>
		<header data-scroll-item='inline-detached'>
			<h1>Hardware wallets summary</h1>
			<p>{intro}</p>
		</header>

		<HardwareWalletTable client:visible title='Hardware Wallets' />
	</main>
</Layout>

<style>
	/* Same column as the wallet table title below. */
	main[data-sticky-container] {
		--scrollItem-inlineDetached-maxSize: 60.5rem;
		--scrollItem-inlineDetached-paddingStart: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
		--scrollItem-inlineDetached-paddingEnd: clamp(
			1.5rem,
			0.04 * var(--scrollContainer-sizeInline),
			3rem
		);
	}

	main > header {
		padding-block-start: 2rem;

		h1 {
			margin: 0 0 0.75rem;
			font-size: 2rem;
		}

		p {
			margin: 0;
			max-inline-size: 48rem;
			color: var(--text-secondary);
			line-height: 1.6;
		}
	}
</style>
