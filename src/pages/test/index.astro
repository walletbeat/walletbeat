---
// Layouts
import Layout from '../../layouts/Layout.astro'

// Components
import Navigation from '@/views/Navigation.astro'
import { defaultNavigationItems } from '@/constants/navigation'
import WalletTest from '../../components/WalletTest.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat – Wallet test playground',
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main data-column-item='flexible' data-sticky-container data-column='gap-6'>
		<header data-scroll-item='inline-detached padding-match-start' data-column='gap-4'>
			<h1>Wallet test playground</h1>

			<p>
				Use this page to manually exercise basic wallet flows (connect, send, sign) against your
				current network. This is a developer tool and does not store any data.
			</p>
		</header>

		<WalletTest client:load />
	</main>
</Layout>

<style>
	main {
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 80rem;
		}
	}
</style>
