---
// Functions
import { staticMarkdownDir } from '@/utils/markdown-page-utils'

// Components
import MarkdownPage from '@/layouts/MarkdownPage.astro'

// Data
import markdownFiles from '@/autogen/governance.gen'

// Context
export const { renderPage, prerender, getStaticPaths } = staticMarkdownDir({
	markdownFiles,
	stripPrefix: '/governance/',
})

const { metadata, repoRootRelativePath, processedMarkdown } = renderPage(Astro.params)
---

<MarkdownPage
	metadata={metadata}
	repoRootRelativePath={repoRootRelativePath}
	markdown={processedMarkdown}
/>
