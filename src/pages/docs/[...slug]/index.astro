---
// Functions
import { staticMarkdownDir } from '@/utils/markdown-page-utils'

// Components
import MarkdownPage from '@/layouts/MarkdownPage.astro'
import IndexPage from '@/layouts/IndexPage.astro'

// Data
import markdownFiles from '@/autogen/docs.gen'

// Context
export const { renderPage, prerender, getStaticPaths } = staticMarkdownDir({
	markdownFiles,
	stripPrefix: '/resources/docs/',
	urlPrefix: '/docs/',
})

const rendered = renderPage(Astro.params)
---

{
	rendered.type === 'page' ? (
		<MarkdownPage
			metadata={rendered.metadata}
			repoRootRelativePath={rendered.repoRootRelativePath}
			markdown={rendered.processedMarkdown}
		/>
	) : (
		<IndexPage metadata={rendered.metadata} entries={rendered.entries} />
	)
}
