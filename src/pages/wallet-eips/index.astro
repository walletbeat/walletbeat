---
import PageLayout from '@/layouts/PageLayout.astro'
import WalletEipList from '@/components/WalletEipList.svelte'
import { eips } from 'data/eips'
---

<PageLayout
	metadata={{
		title: 'Wallet EIPs - Walletbeat',
		description:
			'A reference of Ethereum Improvement Proposals (EIPs and ERCs) tracked by Walletbeat — with plain-English explanations of why each one matters for wallets.',
	}}
	title='Wallet EIPs'
	description='Ethereum standards tracked by Walletbeat and why they matter for wallets.'
>
	<div data-scroll-item='inline-detached padding-match-end'>
		<WalletEipList eips={Object.values(eips)} client:visible />
	</div>
</PageLayout>
