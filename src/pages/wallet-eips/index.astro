---
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import { defaultNavigationItems } from '@/constants/navigation'
import WalletEipList from '@/components/WalletEipList.svelte'
import { eips } from 'data/eips'
---

<Layout
	metadata={{
		title: 'Wallet EIPs - Walletbeat',
		description:
			'A reference of Ethereum Improvement Proposals (EIPs and ERCs) tracked by Walletbeat — with plain-English explanations of why each one matters for wallets.',
	}}
>
	<Navigation slot='nav' navigationItems={defaultNavigationItems} />

	<main
		data-column-item='flexible'
		data-sticky-container
		data-sticky-breadcrumb='scope root'
		data-column='gap-8'
	>
		<header
			id='top'
			data-scroll-item='inline-detached'
			data-sticky='block block-start backdrop-after backdrop-stuck'
			data-sticky-breadcrumb='position'
		>
			<hgroup data-column='gap-4'>
				<div data-row data-sticky='block block-start backdrop-self backdrop-always'>
					<h1 data-sticky-breadcrumb='source'>
						<a href='#top' data-link='camouflaged' data-sticky-breadcrumb='item'>Wallet EIPs</a>
					</h1>
				</div>
				<p data-sticky-breadcrumb='support'>
					<span>Ethereum standards tracked by Walletbeat and why they matter for wallets.</span>
				</p>
			</hgroup>
		</header>

		<div data-scroll-item='inline-detached padding-match-end'>
			<WalletEipList eips={Object.values(eips)} client:visible />
		</div>
		<span data-sticky-breadcrumb='flow' aria-hidden='true'
			><span data-sticky-breadcrumb='measure'></span></span
		>
		<span data-sticky-breadcrumb='flow exit' aria-hidden='true'></span>
	</main>
</Layout>

<style>
	main {
		&[data-sticky-container] {
			--scrollItem-inlineDetached-maxSize: 58rem;
			--scrollItem-inlineDetached-maxPaddingMatchStart: 5rem;
			--scrollItem-inlineDetached-maxPaddingMatchEnd: 5rem;
		}

		line-height: 1.4;

		hgroup p {
			font-size: 1.1rem;
			color: var(--text-secondary);
			opacity: 0.75;
		}
	}
</style>
