---
// Types/constants
import { WalletType } from '@/schema/wallet-types'
import { defaultNavigationItems } from '@/constants/navigation'
import { allRatedWallets } from '@/data/wallets'
import { attributeTree } from '@/schema/attribute-groups'

const attributeGroups = Object.values(attributeTree)

// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import WalletTable from '@/views/WalletTable.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat',
	}}
>
	<Navigation navigationItems={defaultNavigationItems} />

	<main data-sticky-container>
		<WalletTable
			client:load
			title='Embedded Wallets'
			description='Embedded wallets are wallet capabilities (often SDKs) integrated into other applications—such as dapps, games, or services—so users can sign in and transact without a separate wallet app. They are evaluated on security, key custody and recovery, privacy, transparency, and how well they fit the expectations of in-app wallet experiences.'
			wallets={Object.values(allRatedWallets).filter(wallet => wallet.types[WalletType.EMBEDDED])}
			{attributeGroups}
		/>
	</main>
</Layout>
