---
// Types/constants
import { defaultNavigationItems } from '@/constants/navigation'
import { embeddedWalletAttributeTree, ratedEmbeddedWallets } from '@/data/embedded-wallets'

// Components
import Layout from '@/layouts/Layout.astro'
import Navigation from '@/views/Navigation.astro'
import WalletTable from '@/views/WalletTable.svelte'
import WalletTableData from '@/views/WalletTableData.svelte'
---

<Layout
	metadata={{
		title: 'Walletbeat',
	}}
>
	<Navigation navigationItems={defaultNavigationItems} />

	<main data-sticky-container>
		<WalletTableData client:idle title='Embedded Wallets' tableDataId='embedded-summary'>
			<WalletTable
				title='Embedded Wallets'
				wallets={Object.values(ratedEmbeddedWallets)}
				attributeTree={embeddedWalletAttributeTree}
			/>
		</WalletTableData>
	</main>
</Layout>
