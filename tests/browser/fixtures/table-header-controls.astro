---
import Layout from '@/layouts/Layout.astro'
import TableHeaderControls from './TableHeaderControls.svelte'
---

<Layout metadata={{ title: 'Table header controls fixture' }}>
	<TableHeaderControls
		deep={Astro.url.pathname.replace(/\/$/, '').endsWith('-deep')}
		titleControls={Astro.url.pathname.includes('table-title-controls')}
		titleHitAreas={!Astro.url.pathname.includes('baseline')}
		client:load
	/>
</Layout>
