{
	"tools": {
		"read": "allow",
		"grep": "allow",
		"ast_grep_search": "allow",
		"find": "allow",
		"ls": "allow",
		"ast_grep_replace": "allow",
		"agent_browser": "allow",
		"lsp_navigation": "allow",
	},
	"bash": {
		"pwd": "allow",
		"ls": "allow",
		"ls *": "allow",
		"git status": "allow",
		"git diff": "allow",
		"git log": "allow",
		"git log *": "allow",
		"grep *": "allow",
		"find *": "ask", // Can be chained with arbitrary command
		"pnpm run *": "ask",
		"pnpm dev": "allow",
		"pnpm dev:*": "allow",
		"pnpm build": "allow",
		"pnpm lint": "allow",
		"pnpm fix": "allow",
		"pnpm preview": "allow",
		"pnpm check:*": "allow",
		"pnpm generate:*": "allow",
		"pnpm collect:*": "allow",
		"pnpm prettier": "allow",
		"pnpm prettier *": "allow",
		"npx prettier *": "allow",
		"npx vitest *": "allow",
		"wc *": "allow",
		"file *": "allow",
		"cat *": "allow",
		"head *": "allow",
		"tail *": "allow",
		"sort": "allow",
	},
}
